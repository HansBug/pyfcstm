def int seq = 0;
state Root {
    event Halt;
    [*] -> Sys;
    state Sys {
        [*] -> P;
        state P {
            exit { seq = seq * 10 + 3; }
            region A { [*] -> A1; state A1 { exit { seq = seq * 10 + 2; } } }
            region B { [*] -> B1; state B1 { exit { seq = seq * 10 + 1; } } }
        }
    }
    state Safe;
    !Sys -> Safe : /Halt;
}
