@startuml
hide empty description

skinparam state {
  BackgroundColor<<pseudo>> LightGray
  BackgroundColor<<composite>> LightBlue
  BorderColor<<pseudo>> Gray
  FontStyle<<pseudo>> italic
}

legend top left
|= Variable |= Type |= Initial Value |= Role |
| proceed | int | N/A | input |
endlegend

state "Workflow" as workflow <<composite>> {
    state "Job" as workflow__job <<composite>> {
        state "region 1: A" as workflow__job__a <<region>> #line.dashed {
            state "Q" as workflow__job__a__q <<composite>> {
                state "region 1: A1" as workflow__job__a__q__a1 <<region>> #line.dashed {
                    state "Working" as workflow__job__a__q__a1__working
                    [*] --> workflow__job__a__q__a1__working
                    workflow__job__a__q__a1__working --> [*] : /A1Done
                }
                --
                state "region 2: A2" as workflow__job__a__q__a2 <<region>> #line.dashed {
                    state "Working" as workflow__job__a__q__a2__working
                    [*] --> workflow__job__a__q__a2__working
                    workflow__job__a__q__a2__working --> [*] : /A2Done
                }
            }
            state "Packing" as workflow__job__a__packing
            [*] --> workflow__job__a__q
            workflow__job__a__q --> workflow__job__a__packing
            workflow__job__a__packing --> [*] : /ADone
        }
        --
        state "region 2: B" as workflow__job__b <<region>> #line.dashed {
            state "Working" as workflow__job__b__working
            [*] --> workflow__job__b__working
            workflow__job__b__working --> [*] : /BDone
        }
        --
        state "region 3: C" as workflow__job__c <<region>> #line.dashed {
            state "Working" as workflow__job__c__working
            [*] --> workflow__job__c__working
            workflow__job__c__working --> [*] : /CDone
        }
    }
    state "AwaitPermission" as workflow__await_permission
    state "Ready" as workflow__ready
    state "Idle" as workflow__idle
    workflow__job --> workflow__idle : Cancel
    [*] --> workflow__job
    workflow__job --> workflow__await_permission
    workflow__await_permission --> workflow__ready : proceed != 0
}
[*] --> workflow
workflow --> [*]
@enduml