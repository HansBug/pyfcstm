def int a = 1;
state Root {
    event Finish;
    [*] -> P;
    state P {
        region R {
            [*] -> W;
            state W { exit { a = a - 3; } }
            W -> [*] : /Finish;
        }
    }
    state ViaForced;
    state ViaOrdinary;
    !P -> ViaForced : if [a < 0];
    P -> ViaOrdinary;
}
