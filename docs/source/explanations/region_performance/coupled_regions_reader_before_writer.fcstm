input int x0;
def int p = 0;
def int c = 0;
def int d = 0;
state Root { [*] -> P; state P {
region V { [*] -> B0;
  state B0 { during { d = d + 1; } }
  state B1 { during { d = d + 1; } }
  B0 -> B1 : if [p != 0] effect { c = c + 1; };
  B1 -> B0 : if [p == 0] effect { c = c + 1; };
}
region W { [*] -> A; state A { during { p = x0; } } }
} }
