input int sensor;
param int limit = 10;
control int score = 0;
output int reading = 0;

state Root {
    state Start {
        exit { score = score + 1; }
    }
    state Target {
        enter { score = score + 10000; }
        state Good {
            enter { score = score + 1000; }
        }
        [*] -> Good : if [reading >= limit];
    }
    state Fallback {
        enter { score = score + 100; }
    }

    [*] -> Start;
    Start -> Target :: A + B effect {
        reading = sensor;
        score = score + 10;
    }
    Start -> Fallback :: A effect { score = score + 20; }
}
