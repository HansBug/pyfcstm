int {{ M }}_cycle_with_inputs(
    {{ M }} *machine,
    const {{ M }}Inputs *inputs)
{
    _{{ M }}Priv *p;
    {{ M }}Inputs sampled;
    int success;
    if (machine == NULL) {
        return {{ MM }}_FAILURE;
    }
    p = _{{ M }}_priv(machine);
    p->delta = 0;
    if (!p->initialized) {
        _{{ M }}_set_error(machine, "Machine is not initialized; call {{ M }}_init(...) or {{ M }}_hot_start(...) before cycle().");
        return {{ MM }}_FAILURE;
    }

    _{{ M }}_clear_error(machine);
    if (p->ctx.ended) {
        return {{ MM }}_SUCCESS;
    }

    if (_{{ M }}_require_event_checks_mounted(machine) != {{ MM }}_SUCCESS) {
        return {{ MM }}_FAILURE;
    }
    _{{ M }}_event_set_reset(&p->events);

    memset(&sampled, 0, sizeof(sampled));
    if (inputs != NULL) {
        sampled = *inputs;
    } else {
{% for item in model.inputs.values() %}        if (p->input_provider.read_{{ item.name | readonly_value_identifier }} == NULL) {
            _{{ M }}_set_error(machine, "Missing input provider for {{ item.name }}");
            return {{ MM }}_FAILURE;
        }
        if (p->input_provider.read_{{ item.name | readonly_value_identifier }}(p->input_user_data, &sampled.{{ item.name | readonly_value_identifier }}) != {{ MM }}_SUCCESS) {
            _{{ M }}_set_error(machine, "Input provider failed for {{ item.name }}");
            return {{ MM }}_FAILURE;
        }
{% endfor %}    }
{% for item in model.inputs.values() if item.type == 'float' %}    if (!(sampled.{{ item.name | readonly_value_identifier }} >= -DBL_MAX && sampled.{{ item.name | readonly_value_identifier }} <= DBL_MAX)) {
        _{{ M }}_set_error(machine, "Input {{ item.name }} must be finite");
        return {{ MM }}_FAILURE;
    }
{% endfor %}    p->active_inputs = &sampled;
    success = _{{ M }}_run_cycle(p);
    p->active_inputs = NULL;
    if (success) {
        p->last_inputs = sampled;
        p->has_last_inputs = 1;
        _{{ M }}_clear_error(machine);
    }
    return success ? {{ MM }}_SUCCESS : {{ MM }}_FAILURE;
}

