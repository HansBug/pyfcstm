{% set state_items = model.walk_states() | list -%}
{% set event_ns = namespace(items=[]) -%}
{% for state in state_items -%}
{% for event in state.events.values() -%}
{% set event_ns.items = event_ns.items + [event.path_name] -%}
{% endfor -%}
{% endfor -%}
{% set abstract_ns = namespace(rows=[]) -%}
{% set action_scan = namespace(items=[]) -%}
{% for scan_state in state_items -%}
{% for scan_group in [
    scan_state.list_on_enters(with_ids=True),
    scan_state.list_on_durings(aspect=None, with_ids=True),
    scan_state.list_on_exits(with_ids=True),
    scan_state.list_on_durings(aspect='before', with_ids=True),
    scan_state.list_on_durings(aspect='after', with_ids=True),
    scan_state.list_on_during_aspects(aspect='before', with_ids=True),
    scan_state.list_on_during_aspects(aspect='after', with_ids=True),
] -%}
{% for _, scan_item in scan_group -%}
{% set action_scan.items = action_scan.items + [scan_item] -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% set action_ref_hop_limit = (action_scan.items | length) + 1 -%}
{% for state in state_items -%}
{% for group in [
    state.list_on_enters(with_ids=True),
    state.list_on_durings(aspect=None, with_ids=True),
    state.list_on_exits(with_ids=True),
    state.list_on_durings(aspect='before', with_ids=True),
    state.list_on_durings(aspect='after', with_ids=True),
    state.list_on_during_aspects(aspect='before', with_ids=True),
    state.list_on_during_aspects(aspect='after', with_ids=True),
] -%}
{% for _, item in group -%}
{% set resolved = namespace(item=item) -%}
{% for _ in range(action_ref_hop_limit) -%}
{% if resolved.item.ref is not none -%}
{% set resolved.item = resolved.item.ref -%}
{% endif -%}
{% endfor -%}
{% if resolved.item.is_abstract and resolved.item.func_name not in abstract_ns.rows | map(attribute='func_name') | list -%}
{% set abstract_ns.rows = abstract_ns.rows + [{
    'func_name': resolved.item.func_name,
    'hook_name': hook_field_id_name(resolved.item),
    'owner_path': action_owner_path(resolved.item),
    'stage': resolved.item.stage,
    'aspect': resolved.item.aspect,
}] -%}
{% endif -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% set m = machine_class_name(model) -%}
{% set a = machine_macro_name(model) -%}

# {{ m }}

本目录提供自包含的 C99 状态机运行时。将应用代码放在 `app.c` 中；模型行为变化时修改 DSL 并重新生成状态机文件。生成程序不依赖 Python 或第三方运行时库。

**生成文件：**通过 `machine.h` 公开函数接入应用。`machine.c` 是生成的实现文件。`README.md` 提供对应英文指南。依次阅读[快速开始](#quick-start)、[接入说明](#integration)、[恢复](#recovery)和[编译](#build)。

<a id="quick-start"></a>

## 快速开始

将下面的完整程序保存为 `app.c`。程序按模型声明配置参数、连接输入并注册抽象动作。{% if model.inputs or model.parameters %}数值 `1` 仅用于演示，请替换为适合当前模型的读数和配置。{% endif %}动作回调打印观察值，可将其函数体替换为应用逻辑。初始化一次后，由应用调度器对同一个实例重复调用周期入口。

<!-- example:quick-start -->

```c
#include "machine.h"
#include <stdio.h>
#include <string.h>

typedef struct AppData {
    {{ m }}Inputs inputs;
    int hook_calls;
    int event_active;
} AppData;

{% for item in model.inputs.values() %}static int app_read_{{ item.name | readonly_value_identifier }}(void *user_data, {% if item.type == 'int' %}{{ m }}Int{% else %}double{% endif %} *value)
{
    AppData *data = (AppData *)user_data;
    /* Replace this lookup with your sensor/driver call; return 0 on failure. */
    *value = data->inputs.{{ item.name | readonly_value_identifier }};
    return 1;
}

{% endfor %}{% if abstract_ns.rows %}static void app_action({{ m }} *machine, const {{ m }}ExecutionContext *ctx, void *user_data)
{
    AppData *data = (AppData *)user_data;
    (void)machine;
    ++data->hook_calls;
{% for item in model.inputs.values() %}    printf("input {{ item.name }} = %.17g\n", (double){{ m }}_get_input_{{ item.name | readonly_value_identifier }}(machine));
{% endfor %}{% for item in model.parameters.values() %}    printf("param {{ item.name }} = %.17g\n", (double){{ m }}_get_param_{{ item.name | readonly_value_identifier }}(machine));
{% endfor %}    printf("action %d stage %d\n", (int)ctx->action_id, (int)ctx->action_stage_id);
}

{% endif %}
int main(void)
{
    {{ m }}InitOptions options;
    AppData data;
    memset(&options, 0, sizeof(options));
    memset(&data, 0, sizeof(data));
{% for item in model.parameters.values() %}    options.parameters.{{ item.name | readonly_value_identifier }} = 1;
    options.parameters_present.{{ item.name | readonly_value_identifier }} = 1;
{% endfor %}    {{ m }} machine;
    if (!{{ m }}_init_with_options(&machine, &options)) {
        fprintf(stderr, "%s\n", {{ m }}_last_error(&machine));
        return 1;
    }
{% if model.inputs %}
    {{ m }}InputProvider provider;
    memset(&provider, 0, sizeof(provider));
{% for item in model.inputs.values() %}    data.inputs.{{ item.name | readonly_value_identifier }} = 1;
    provider.read_{{ item.name | readonly_value_identifier }} = app_read_{{ item.name | readonly_value_identifier }};
{% endfor %}    {{ m }}_set_input_provider(&machine, &provider, &data);
{% endif %}{% if abstract_ns.rows %}
    {{ m }}Hooks hooks = {{ m | upper }}_HOOKS_INIT;
{% for row in abstract_ns.rows %}    hooks.{{ row['hook_name'] }} = app_action;
{% endfor %}    {{ m }}_set_hooks(&machine, &hooks, &data);
{% endif %}
    /* Keep this instance and AppData alive for subsequent host-scheduled cycles. */
    if (!{{ m }}_cycle(&machine, NULL, 0u)) {
        fprintf(stderr, "%s\n", {{ m }}_last_error(&machine));
        return 2;
    }
{% for item in model.parameters.values() %}    printf("param {{ item.name }} = %.17g\n", (double){{ m }}_get_param_{{ item.name | readonly_value_identifier }}(&machine));
{% endfor %}{% for item in model.persistent_variables.values() %}    printf("{{ item.role.value }} {{ item.name }} = %.17g\n",
           (double){{ m }}_vars(&machine)->{{ item.name | to_c_identifier }});
{% endfor %}    printf("hook calls = %d\n", data.hook_calls);
    /* Send committed outputs to your actuator/driver after success. */
    return 0;
}
```

```bash
cc -std=c99 -Wall -Wextra -pedantic -O2 machine.c app.c -lm -o app
./app
```

上述命令面向 POSIX 宿主工具链；Windows、CMake 和无堆配置见编译章节。后续每拍更新 `data.inputs`，或直接在输入提供器中读取设备，再调用同一周期入口。`is_ended()` 为真时停止。实例、回调表和应用数据须在整个运行期间保持有效。

<a id="integration"></a>

## 接入输入、动作与事件

| 角色 | 应用负责什么 | 模型运行期间 |
| --- | --- | --- |
| `input` | 实现下方读取接口，或为当前周期提供显式快照 | 每周期重新获取；模型只读，没有默认保持 |
| `param` | 构造/初始化时传入；省略项使用 DSL 默认值 | 实例固定，只有 getter，不需要实现回调 |
| `control`（`def`，通常称 var） | 可在初始化时预设，运行后只读观察 | 模型内部可写；未赋值保持原值 |
| `output` | 在成功周期之后读结果，并按需交给执行器 | 与 control 共用持久存储；未赋值保持原值 |

`Vars` 保存 control/output，仅由 DSL 写入。初始化时复制并校验 `Parameters`。在 `InitOptions` 中为每个指定值设置对应存在标记，缺省项使用 DSL 默认值。输入可通过下表中的回调接入，也可提供完整类型化 `Inputs` 快照。执行前对全部输入采样一次，包括未使用的输入，验证和动作使用相同值。

整数输入回调写入生成的有符号 64 位 `Int`，浮点输入回调写入有限 `double`。模型声明了输入时，缺少输入提供器、非有限数值或回调返回 0 都会使周期失败。input getter 要求周期正在执行，param getter 要求实例已初始化。

{% if model.defines %}
| 角色 | DSL 名称 | 访问入口 |
| --- | --- | --- |
{% for item in model.inputs.values() %}| input | `{{ item.name }}` | `InputProvider.read_{{ item.name | readonly_value_identifier }}`; `get_input_{{ item.name | readonly_value_identifier }}` |
{% endfor %}{% for item in model.parameters.values() %}| param | `{{ item.name }}` | `InitOptions.parameters.{{ item.name | readonly_value_identifier }}` + `parameters_present.{{ item.name | readonly_value_identifier }}`; `get_param_{{ item.name | readonly_value_identifier }}` |
{% endfor %}{% for item in model.persistent_variables.values() %}| {{ item.role.value }} | `{{ item.name }}` | `Vars.{{ item.name | to_c_identifier }}` |
{% endfor %}

{% else %}
此模型没有 input、param、control 或 output 声明。
{% endif %}

### 回调职责

| 接口 | 调用时机 | 返回值与所有权 |
| --- | --- | --- |
| `InputProvider.read_*` | 每个未结束周期对全部输入各调用一次；显式快照绕过输入提供器 | 写入指定类型的值并返回 1，返回 0 则采样失败。复制函数表，借用 `user_data` |
| `Hooks` | 执行抽象生命周期动作时；推测验证阶段不调用 | 无返回值，未挂载的槽位不执行动作。借用函数表和 `user_data` |

快速开始中的回调通过 `user_data` 共享 `AppData`。Hook 表应存放在拥有状态机的对象或其他足够长寿的作用域中，不能注册即将离开作用域的局部表。在动作中通过 `ctx->vars` 读取动作发生时的值，通过传入实例的 getter 读取 input/param。不要从回调修改持久状态，应在 DSL 中表达状态变化；若执行器必须反映已提交状态，应在周期成功后发送 output。

### 已声明的动作

{% if abstract_ns.rows %}
| Hook 字段 | DSL 动作路径 | 所属状态 | 阶段 |
| --- | --- | --- | --- |
{% for row in abstract_ns.rows %}| `{{ row['hook_name'] }}` | `{{ row['func_name'] }}` | `{{ row['owner_path'] }}` | `{{ row['stage'] }}{% if row['aspect'] %} {{ row['aspect'] }}{% endif %}` |
{% endfor %}
{% else %}
此模型未声明抽象动作。

{% endif %}
