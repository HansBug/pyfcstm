class _Branch(object):
    """The stack of one region of an owner that is at work."""

    __slots__ = ("region", "stack")

    def __init__(self, region, stack):
        self.region = region
        self.stack = stack

    @property
    def status(self):
        if not self.stack:
            return "pending"
        if len(self.stack) == 1:
            return "done" if self.stack[0].mode == "post_child_exit" else "pending"
        return "live"


