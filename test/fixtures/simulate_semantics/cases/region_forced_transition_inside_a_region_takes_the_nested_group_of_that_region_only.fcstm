def int seq = 0;
state Root {
    event Reset;
    [*] -> P;
    state P {
        region A {
            [*] -> Q;
            state Q {
                exit { seq = seq * 10 + 4; }
                region X { [*] -> X1; state X1 { exit { seq = seq * 10 + 1; } } }
                region Y { [*] -> Y1; state Y1 { exit { seq = seq * 10 + 2; } } }
            }
            state Home { enter { seq = seq * 10 + 9; } }
            !Q -> Home : /Reset;
        }
        region B { [*] -> B1; state B1 { exit { seq = seq * 10 + 3; } } }
    }
}
