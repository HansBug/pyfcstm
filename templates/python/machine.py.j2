class _Pending(object):
    """Marks a region that waits for its initial transition (``[init]``)."""

    def __repr__(self):
        return "[init]"


_PENDING = _Pending()
_UNSET = object()
# Modes of a frame: where the state or region on top of a stack is in its life.
_ACTIVE = 0
_AFTER_ENTRY = 1
_INIT_WAIT = 2
_POST_CHILD_EXIT = 3
_STABLE = "stable"
_ENDED = "ended"
_FAILED = "failed"
_CONTINUE = "continue"
_REGION_DONE = "region_done"
_TEXT_TOKENS = re.compile(r"\[init\]|\[done\]|[A-Za-z_][A-Za-z_0-9]*|\S")
_TEXT_IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z_0-9]*")


_ERROR_REPR = Repr()
_ERROR_REPR.maxstring = 80


class _Frame(object):
    """One level of an execution stack."""

    __slots__ = ("state", "mode", "plain_before_pending", "branches")

    def __init__(self, state, mode, plain_before_pending=False, branches=None):
        self.state = state
        self.mode = mode
        self.plain_before_pending = plain_before_pending
        self.branches = branches


class _Branch(object):
    """The stack of one region of an owner that is at work."""

    __slots__ = ("region", "stack")

    def __init__(self, region, stack):
        self.region = region
        self.stack = stack

    @property
    def status(self):
        if not self.stack:
            return "pending"
        if len(self.stack) == 1:
            return "done" if self.stack[0].mode == _POST_CHILD_EXIT else "pending"
        return "live"


class _Outer(object):
    """Link from a branch stack back to the stack that owns it."""

    __slots__ = ("stack", "index", "parent")

    def __init__(self, stack, index, parent):
        self.stack = stack
        self.index = index
        self.parent = parent


class _Run(object):
    """Bookkeeping of one advance of a stack."""

    def __init__(self, is_validation_mode=False, validate_post_child_exit=True):
        self.is_validation_mode = is_validation_mode
        self.validate_post_child_exit = validate_post_child_exit
        self.steps_taken = 0
        self.seen_signatures = set()


def _position_text(position, prefix=0):
    """Format a position tree the way ``str(Configuration)`` does."""
    path, regions = position
    result = ".".join(path[prefix:])
    if regions:
        parts = []
        for name, child in regions:
            if child is None:
                value = "[done]"
            elif child is _PENDING:
                value = "[init]"
            else:
                value = _position_text(child, len(path) + 1)
            parts.append("%s: %s" % (name, value))
        result += "{" + ", ".join(parts) + "}"
    return result


def _positions(position):
    yield position
    for _, child in position[1]:
        if isinstance(child, tuple):
            for item in _positions(child):
                yield item


class _TextParser(object):
    """Reads the configuration text written by :func:`_position_text`."""

    def __init__(self, text):
        if not isinstance(text, str):
            raise TypeError("Configuration text must be a string.")
        self.text = text
        self.tokens = [
            (match.group(), match.start()) for match in _TEXT_TOKENS.finditer(text)
        ]
        self.index = 0

    def peek(self):
        return self.tokens[self.index][0] if self.index < len(self.tokens) else ""

    def location(self):
        if self.index < len(self.tokens):
            offset = self.tokens[self.index][1]
        else:
            offset = len(self.text)
        line = self.text.count("\n", 0, offset) + 1
        column = offset - self.text.rfind("\n", 0, offset)
        return "line %d, column %d" % (line, column)

    def error(self, expected):
        actual = _ERROR_REPR.repr(self.peek()) if self.peek() else "end of input"
        raise ValueError(
            "Expected %s at %s, got %s." % (expected, self.location(), actual)
        )

    def take(self, expected=None):
        token = self.peek()
        if not token or (expected is not None and token != expected):
            self.error(repr(expected))
        self.index += 1
        return token

    def identifier(self):
        if _TEXT_IDENTIFIER.fullmatch(self.peek()) is None:
            self.error("a configuration identifier")
        return self.take()

    def position(self, base=()):
        path = [self.identifier()]
        while self.peek() == ".":
            self.take(".")
            path.append(self.identifier())
        path = tuple(base) + tuple(path)
        regions = []
        if self.peek() == "{":
            self.take("{")
            while True:
                name = self.identifier()
                self.take(":")
                if self.peek() == "[done]":
                    self.take("[done]")
                    child = None
                elif self.peek() == "[init]":
                    self.take("[init]")
                    child = _PENDING
                else:
                    child = self.position(path + (name,))
                regions.append((name, child))
                if self.peek() != ",":
                    break
                self.take(",")
            self.take("}")
        return (path, tuple(regions))


def _position_of_stack(stack):
    """Build the position tree of a stack, one entry per active branch."""
    top = [frame for frame in stack if not _IS_REGION[frame.state]][-1]
    regions = []
    if top.branches is not None:
        for branch in top.branches:
            if branch.status == "pending":
                child = _PENDING
            elif branch.status == "done":
                child = None
            else:
                child = _position_of_stack(branch.stack)
            regions.append((_PATH[branch.region][-1], child))
    else:
        regions = [(name, _PENDING) for name in _REGION_NAMES[top.state]]
    return (_PATH[top.state], tuple(regions))


def _clone_stack(stack):
    return [
        _Frame(
            frame.state,
            frame.mode,
            frame.plain_before_pending,
            None
            if frame.branches is None
            else [
                _Branch(branch.region, _clone_stack(branch.stack))
                for branch in frame.branches
            ],
        )
        for frame in stack
    ]


def _stack_shape(stack, skip=None):
    shape = []
    last = len(stack) - 1
    for position, frame in enumerate(stack):
        item = (frame.state, frame.mode, frame.plain_before_pending)
        if frame.branches is not None:
            item += (
                tuple(
                    None
                    if position == last and index == skip
                    else _stack_shape(branch.stack)
                    for index, branch in enumerate(frame.branches)
                ),
            )
        shape.append(item)
    return tuple(shape)


def _create_execution_signature(stack, vars_):
    return _stack_shape(stack), tuple((key, vars_[key]) for key in sorted(vars_))


def _find_frame_in(stack, scope):
    """Find the stack and index of the frame that holds ``scope``."""
    for index, frame in enumerate(stack):
        if frame.state == scope:
            return stack, index
        for branch in frame.branches or ():
            found = _find_frame_in(branch.stack, scope)
            if found is not None:
                return found
    return None{% endraw %}


