input int sensor;
param int limit = 10;
control int score = 0;
output int reading = 0;

state Root {
    enter { score = score + 100; }
    pseudo state Prepare {
        enter { score = score + 10; }
    }
    state Ready {
        enter { score = score + 1000; }
    }
    [*] -> Prepare effect { reading = sensor; }
    Prepare -> Ready : if [reading >= limit];
}
