def int seq = 0;
state Root {
    event Stop;
    [*] -> P;
    state P {
        region A { [*] -> A1; state A1 { during { seq = seq * 10 + 1; } exit { seq = seq * 10 + 8; } } }
        region B { [*] -> B1; state B1; }
    }
    state Blocked { [*] -> In : if [seq < 0]; state In; }
    state Other;
    !P -> Blocked : /Stop;
    P -> Other : /Stop;
}
