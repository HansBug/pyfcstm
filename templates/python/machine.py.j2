@dataclass(frozen=True)
class ReadOnlyExecutionContext:
    """
    Read-only execution context passed to abstract handlers.

    :param state_path: State path that owns the executing action. A leaf for
        leaf lifecycle actions and for ancestor aspect actions, which run
        for a descendant leaf's cycle; entering or leaving a composite
        state, or running a plain ``during`` action declared on one, gives
        that composite state's own path.
    :type state_path: Tuple[str, ...]
    :param vars: Snapshot of machine variables.
    :type vars: Mapping[str, Number]
    :param action_name: Resolved abstract target action path.
    :type action_name: str
    :param action_stage: Lifecycle callsite stage.
    :type action_stage: str
    :param active_leaf: Runtime state path where the action executes: the
        active leaf state when one is active, otherwise the action's host
        state path. Defaults to ``state_path``, which is the host path.
    :type active_leaf: Tuple[str, ...], optional
    :param call_stage: Explicit callsite lifecycle stage, defaults to
        ``action_stage``.
    :type call_stage: str, optional
    :param abstract_target: Resolved abstract target action path, defaults to
        ``action_name``.
    :type abstract_target: str, optional
    :param named_ref: Full path of the named ref callsite. Anonymous
        refs and direct abstract actions use ``None``.
    :type named_ref: Optional[str], optional
    :param parameters: Fixed instance parameter snapshot.
    :type parameters: Mapping[str, Number]
    :param inputs: Frozen input snapshot for the current cycle.
    :type inputs: Mapping[str, Number]
    :param configuration: Whole position at the moment of the call, as text such
        as ``Root.Run{A: X, B: [done]}``; ``state_path`` and ``active_leaf``
        name the deepest state common to every branch the action covers.
    :type configuration: Optional[str]
    """

    state_path: Tuple[str, ...]
    vars: Mapping[str, Number]
    action_name: str
    action_stage: str
    active_leaf: Optional[Tuple[str, ...]] = None
    call_stage: Optional[str] = None
    abstract_target: Optional[str] = None
    named_ref: Optional[str] = None
    parameters: Mapping[str, Number] = field(default_factory=dict, repr=False)
    inputs: Mapping[str, Number] = field(default_factory=dict, repr=False)
    configuration: Optional[str] = None

    def __post_init__(self):
        object.__setattr__(self, "state_path", tuple(self.state_path))
        object.__setattr__(self, "vars", MappingProxyType(dict(self.vars)))
        object.__setattr__(self, "parameters", MappingProxyType(dict(self.parameters)))
        object.__setattr__(self, "inputs", MappingProxyType(dict(self.inputs)))
        active_leaf = self.state_path if self.active_leaf is None else self.active_leaf
        object.__setattr__(self, "active_leaf", tuple(active_leaf))
        call_stage = self.action_stage if self.call_stage is None else self.call_stage
        object.__setattr__(self, "call_stage", call_stage)
        abstract_target = (
            self.action_name if self.abstract_target is None else self.abstract_target
        )
        object.__setattr__(self, "abstract_target", abstract_target)

    def get_var(self, name):
        return self.vars[name]

    def has_var(self, name):
        return name in self.vars

    def get_state_name(self):
        return self.state_path[-1] if self.state_path else ""

    def get_full_state_path(self):
        return ".".join(self.state_path)


