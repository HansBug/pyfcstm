def int seq = 0;
state Root {
    [*] -> P;
    state P {
        during before { seq = seq * 10 + 1; }
        region A { [*] -> A1 effect { seq = seq * 10 + 2; }; state A1 { enter { seq = seq * 10 + 3; } } }
        region B { [*] -> B1 effect { seq = seq * 10 + 4; }; state B1 { enter { seq = seq * 10 + 5; } } }
    }
}
