        return {
            "root_state_name": {{ model.root_state.name | tojson }},
{% if model.has_regions %}            "configuration": None if self._ended else self.configuration,
{% else %}            "current_state_path": self.current_state_path,
{% endif %}            "variable_names": sorted(self._vars.keys()),
            "state_paths": list(self.STATE_PATHS),
            "abstract_hooks": dict(self.ABSTRACT_HOOKS),
            "is_ended": self._ended,
        }

    @classmethod
    def get_abstract_hook_map(cls):
        """
        Return the generated mapping from DSL abstract actions to hook methods.

        :return: Mapping from action path to protected hook method name.
        :rtype: Dict[str, str]
        """
        return dict(cls.ABSTRACT_HOOKS)

{% if model.has_regions %}    def _context_inputs(self):
        """Snapshot of the inputs of the running cycle for an action context."""
        return {% if input_items %}{
{% for item in input_items %}            {{ item.name | tojson }}: self.get_input_{{ item.name }}(),
{% endfor %}        }{% else %}{}{% endif %}

{# region-kernel:classes #}{% raw %}    _DFS_STEP_LIMIT = 1000
    _DFS_STRUCTURAL_DEPTH_LIMIT = 64
    _MODEL = []

    @classmethod
    def _model(cls):
        """Return the linked model of states and regions, built once."""
        if not cls._MODEL:
            cls._MODEL.append(cls._build_model())
        return cls._MODEL[0]

    @classmethod
    def _build_model(cls):
        transitions = {key: _Trans(key, info) for key, info in cls._TRANSITIONS.items()}
        scopes = {}
        for path, info in cls._STATE_INFO.items():
            scope = _Scope()
            scope.path = info["path"]
            scope.name = info["path"][-1]
            scope.is_region = False
            scope.is_pseudo = info["is_pseudo"]
            scope.is_leaf_state = info["is_leaf"]
            scope.is_root_state = info["parent"] is None
            scope.is_stoppable = info["is_leaf"] and not info["is_pseudo"]
            scope.on_enters = info["enter_actions"]
            scope.on_exits = info["exit_actions"]
            scope.plain_durings = info["during_actions"]
            scope.plain_before = info["during_before_actions"]
            scope.plain_after = info["during_after_actions"]
            scope.aspect_before = info["aspect_before_actions"]
            scope.aspect_after = info["aspect_after_actions"]
            scopes[path] = scope
        for path, info in cls._REGION_INFO.items():
            scope = _Scope()
            scope.path = info["path"]
            scope.name = info["path"][-1]
            scope.is_region = True
            scope.is_pseudo = False
            scope.is_leaf_state = False
            scope.is_root_state = False
            scope.is_stoppable = False
            scope.on_enters = scope.on_exits = []
            scope.plain_durings = scope.plain_before = scope.plain_after = []
            scope.aspect_before = info["aspect_before_actions"]
            scope.aspect_after = info["aspect_after_actions"]
            scopes[path] = scope
        for path, info in list(cls._STATE_INFO.items()) + list(
            cls._REGION_INFO.items()
        ):
            scope = scopes[path]
            scope.parent = None if info["parent"] is None else scopes[info["parent"]]
            scope.substates = {
                scopes[item].name: scopes[item] for item in info["substates"]
            }
            scope.regions = {
                scopes[item].name: scopes[item] for item in info.get("regions", ())
            }
            scope.events = dict(info["events"])
            scope.init_transitions = [
                transitions[item] for item in info["initial_transition_ids"]
            ]
            scope.transitions_from = [
                transitions[item] for item in info.get("transition_ids", ())
            ]
        for key, info in cls._TRANSITIONS.items():
            if info["target"] is not None:
                transitions[key].target = scopes[info["target"]]
        return scopes, scopes[cls._ROOT_STATE_PATH]

    @staticmethod
    def _is_no_outgoing_pseudo(state):
        return bool(
            state.is_pseudo
            and not state.transitions_from
            and not state.init_transitions
        )

    def _evaluate_runtime_expr(self, fn, usage):
        try:
            return fn()
        except (ValueError, ArithmeticError, TypeError) as err:
            # ValueError: math domain errors or invalid numeric operations
            # raised while evaluating a user's DSL expression.
            # ArithmeticError: division by zero, overflow, or other numeric
            # runtime failure while evaluating a user's DSL expression.
            # TypeError: Python numeric, bitwise, and shift operators reject
            # runtime operand combinations such as ``float << int``.
            raise SimulationRuntimeExpressionError(
                "%s evaluation failed: %s" % (usage, err)
            ) from err

    # -- positions: queries, text and hot start -------------------------------

    def _lookup(self, path):
        _, root = self._model()
        parts = tuple(path.split(".")) if isinstance(path, str) else tuple(path)
        shown = _ERROR_REPR.repr(".".join(parts))
        if not parts or parts[0] != root.name:
            raise ValueError("Unknown configuration path: %s." % shown)
        current = root
        for segment in parts[1:]:
            current = current.child(segment)
            if current is None:
                raise ValueError("Unknown configuration path: %s." % shown)
        return current

    def _position_now(self):
        if not self._stack:
            raise SimulationRuntimeTerminalStateError(
                "Cannot access configuration: runtime has ended and the "
                "active stack is empty. Check is_ended before querying "
                "configuration."
            )
        return _position_of_stack(self._stack)

    @property
    def configuration(self):
        """
        Return the whole position as text, such as ``Root.Run{A: X, B: [done]}``.

        :return: One state path per branch; a region that finished reads
            ``[done]`` and one that still waits for its initial transition reads
            ``[init]``.
        :rtype: str
        :raises SimulationRuntimeTerminalStateError: If the machine has ended.
        """
        return _position_text(self._position_now())

    @property
    def leaves(self):
        """
        Return the path of every active leaf state, in declaration order.

        :return: Paths of the states that are active and have no children.
        :rtype: Tuple[Tuple[str, ...], ...]
        :raises SimulationRuntimeTerminalStateError: If the machine has ended.
        """
        return tuple(
            position[0]
            for position in _positions(self._position_now())
            if self._lookup(position[0]).is_leaf_state
        )

    def is_active(self, path):
        """
        Return whether a state, or one of its descendants, is active.

        :param path: Full state path, dotted or as a tuple.
        :type path: Union[str, Tuple[str, ...]]
        :return: ``True`` if the state is on an active branch.
        :rtype: bool
        :raises ValueError: If the path is unknown or names a region.
        :raises SimulationRuntimeTerminalStateError: If the machine has ended.
        """
        state = self._lookup(path)
        if state.is_region:
            raise ValueError("is_active requires a State path.")
        return any(
            position[0][: len(state.path)] == state.path
            for position in _positions(self._position_now())
        )

    def region_status(self, path):
        """
        Return ``'live'``, ``'done'``, ``'pending'`` or ``'inactive'`` for a region.

        ``'pending'`` means the owner is active and the region has not been
        initialized yet; ``'inactive'`` means the owner is not on an active
        branch.

        :param path: Full region path, dotted or as a tuple.
        :type path: Union[str, Tuple[str, ...]]
        :return: The status of the region.
        :rtype: str
        :raises ValueError: If the path is unknown or names a state.
        :raises SimulationRuntimeTerminalStateError: If the machine has ended.
        """
        region = self._lookup(path)
        if not region.is_region:
            raise ValueError("region_status requires a Region path.")
        for position in _positions(self._position_now()):
            if position[0] == region.path[:-1]:
                child = dict(position[1])[region.name]
                if child is _PENDING:
                    return "pending"
                return "done" if child is None else "live"
        return "inactive"

    def _validate_position(self, position, base):
        path = position[0]
        if path[: len(base)] != base or len(path) <= len(base):
            raise ValueError(
                "Configuration path %s is outside namespace %s."
                % (_ERROR_REPR.repr(path), _ERROR_REPR.repr(base))
            )
        state = self._lookup(path)
        if state.is_region:
            raise ValueError(
                "A configuration branch must end at a State, not a Region."
            )
        # A linear path cannot skip a parallel owner and select just one region.
        for end in range(len(base) + 1, len(path)):
            ancestor = self._lookup(path[:end])
            if ancestor.regions:
                raise ValueError(
                    "Parallel owner %s requires a region block."
                    % _ERROR_REPR.repr(".".join(ancestor.path))
                )
        context = ".".join(path)
        entries = dict(position[1])
        if len(entries) != len(position[1]):
            raise ValueError(
                "Duplicate region in configuration for %s." % _ERROR_REPR.repr(context)
            )
        if set(entries) - set(state.regions):
            raise ValueError(
                "Unknown region in configuration for %s." % _ERROR_REPR.repr(context)
            )
        ordered = []
        for name in state.regions:
            child = entries.get(name, _PENDING)
            if isinstance(child, tuple):
                child = self._validate_position(child, path + (name,))
            ordered.append((name, child))
        return (path, tuple(ordered))

    def _parse_position(self, text):
        parser = _TextParser(text)
        try:
            position = parser.position()
            if parser.peek():
                parser.error("end of input")
            return self._validate_position(position, ())
        except RecursionError:
            # RecursionError: position() parses nested blocks and the validation
            # walks the resulting recursive position tree within Python's stack
            # limit.
            raise ValueError(
                "Configuration nesting is too deep near %s; "
                "reduce nested region blocks." % parser.location()
            ) from None

    def _position_of_state(self, state):
        node = (state.path, tuple((name, _PENDING) for name in state.regions))
        scope = state
        while scope is not None:
            if scope.is_region:
                owner = scope.parent
                node = (
                    owner.path,
                    tuple(
                        (name, node if name == scope.name else _PENDING)
                        for name in owner.regions
                    ),
                )
            scope = scope.parent
        return node

    def _reject_all_done(self, position):
        if position[1] and all(child is None for _, child in position[1]):
            raise ValueError(
                "All regions are Done at '%s'; a finished owner cannot be hot-started."
                % ".".join(position[0])
            )
        for _, child in position[1]:
            if isinstance(child, tuple):
                self._reject_all_done(child)

    def _resolve_start_position(self, start):
        if isinstance(start, str) and "{" in start:
            position = self._parse_position(start)
        else:
            if isinstance(start, str):
                if not start:
                    raise ValueError("State path cannot be empty")
                path = tuple(start.split("."))
            elif isinstance(start, (tuple, list)):
                path = tuple(start)
            else:
                raise TypeError(
                    "initial_state must be str, tuple or list, got %s"
                    % type(start).__name__
                )
            found = self._lookup(path)
            if found.is_region:
                raise ValueError("%r names a region, not a state" % ".".join(path))
            position = self._position_of_state(found)
        self._reject_all_done(position)
        return position

    def _build_position_stack(self, position, region=None):
        chain = []
        scope = self._lookup(position[0])
        while scope is not region:
            chain.insert(0, scope)
            scope = scope.parent
        frames = [_Frame(state, "active") for state in chain]
        top = frames[-1]
        if position[1]:
            top.branches = []
            for name, child in position[1]:
                owned = top.state.regions[name]
                if child is None:
                    stack = [_Frame(owned, "post_child_exit")]
                elif child is _PENDING:
                    stack = []
                else:
                    stack = [_Frame(owned, "active")] + self._build_position_stack(
                        child, owned
                    )
                top.branches.append(_Branch(owned, stack))
            if all(branch.status == "pending" for branch in top.branches):
                top.mode = "init_wait"
        elif not top.state.is_leaf_state:
            top.mode = "init_wait"
        return frames

    # -- event names -------------------------------------------------------

    def _scope_resolve_event(self, scope, event_ref):
        """Resolve an event name from one state, the way ``State.resolve_event`` does."""
        if not event_ref:
            raise ModelValueError("Event reference cannot be empty")
        root = scope
        while root.parent is not None:
            root = root.parent
        if event_ref.startswith("/"):
            relative_path = event_ref[1:]
            if not relative_path:
                raise ModelValueError("Absolute event reference cannot be just '/'")
            path_parts = relative_path.split(".")
            if not all(path_parts):
                raise ModelValueError(
                    "Invalid absolute event reference: %r" % (event_ref,)
                )
            event_name = path_parts[-1]
            target_path = root.path + tuple(path_parts[:-1])
        elif event_ref.startswith("."):
            dot_count = 0
            for char in event_ref:
                if char == ".":
                    dot_count += 1
                else:
                    break
            remaining_path = event_ref[dot_count:]
            if not remaining_path:
                raise ModelValueError(
                    "Parent-relative event reference cannot end with dots: %r"
                    % (event_ref,)
                )
            path_parts = remaining_path.split(".")
            if not all(path_parts):
                raise ModelValueError(
                    "Invalid parent-relative event reference: %r" % (event_ref,)
                )
            current = scope
            for _ in range(dot_count):
                if current.parent is None:
                    raise ModelValueError(
                        "Parent-relative event reference %r goes beyond root state "
                        "(current state: %s, tried to go up %d levels)"
                        % (event_ref, ".".join(scope.path), dot_count)
                    )
                current = current.parent
            event_name = path_parts[-1]
            target_path = current.path + tuple(path_parts[:-1])
        else:
            path_parts = event_ref.split(".")
            if not all(path_parts):
                raise ModelValueError(
                    "Invalid relative event reference: %r" % (event_ref,)
                )
            event_name = path_parts[-1]
            target_path = scope.path + tuple(path_parts[:-1])
        current = root
        for index, name in enumerate(target_path[1:], 1):
            if current.child(name) is None:
                raise ModelLookupError(
                    "State %r not found in hierarchy while resolving event "
                    "reference %r" % (".".join(target_path[: index + 1]), event_ref)
                )
            current = current.child(name)
        if event_name not in current.events:
            raise ModelLookupError(
                "Event %r not found in state %r while resolving event reference %r"
                % (event_name, ".".join(target_path), event_ref)
            )
        return current.events[event_name]

    def _machine_resolve_event(self, event_path):
        """Resolve a full event path, the way ``StateMachine.resolve_event`` does."""
        _, root = self._model()
        if not event_path:
            raise ModelValueError("Event path cannot be empty")
        path_parts = event_path.split(".")
        if not all(path_parts):
            raise ModelValueError(
                "Invalid event path: %r (contains empty parts)" % (event_path,)
            )
        if len(path_parts) < 2:
            raise ModelValueError(
                "Invalid event path: %r (must contain at least state name and "
                "event name)" % (event_path,)
            )
        event_name = path_parts[-1]
        state_path_parts = path_parts[:-1]
        if state_path_parts[0] != root.name:
            raise ModelLookupError(
                "Event path root '%s' does not match state machine root '%s' "
                "while resolving event path %r"
                % (state_path_parts[0], root.name, event_path)
            )
        current = root
        for index, name in enumerate(state_path_parts[1:], 1):
            if current.child(name) is None:
                raise ModelLookupError(
                    "State '%s' not found in state '%s' while resolving event "
                    "path %r" % (name, ".".join(state_path_parts[:index]), event_path)
                )
            current = current.child(name)
        if event_name not in current.events:
            raise ModelLookupError(
                "Event '%s' not found in state '%s' while resolving event path %r"
                % (event_name, ".".join(state_path_parts), event_path)
            )
        return current.events[event_name]

    def _position_resolve_event(self, event_ref):
        """Resolve an event name from every active leaf of the current position."""
        _, root = self._model()
        leaves = [self._lookup(path) for path in self.leaves] or [root]
        if len(leaves) == 1:
            return self._scope_resolve_event(leaves[0], event_ref)
        if event_ref.startswith("/"):
            return self._scope_resolve_event(root, event_ref)
        found = {}
        errors = []
        for leaf in leaves:
            try:
                event = self._scope_resolve_event(leaf, event_ref)
            except (ModelValueError, ModelLookupError) as err:
                # ModelValueError / ModelLookupError: the name leads nowhere
                # from this leaf; another leaf may still find it.
                errors.append(err)
                continue
            found.setdefault(event, []).append(".".join(leaf.path))
        if not found:
            if all(isinstance(err, ModelValueError) for err in errors):
                # The name is malformed from every leaf, so there is nothing to
                # look up and the first complaint says why.
                raise errors[0]
            where = ", ".join(".".join(leaf.path) for leaf in leaves)
            raise ModelLookupError(
                "Position-dependent event name %s matches no event from any "
                'active leaf (%s); use the full event path or a root-based "/path".'
                % (_ERROR_REPR.repr(event_ref), where)
            )
        if len(found) > 1:
            candidates = "; ".join(
                "%s (from %s)" % (name, ", ".join(origins))
                for name, origins in found.items()
            )
            raise ModelValueError(
                "Position-dependent event name %s is ambiguous: %s; use the "
                'full event path or a root-based "/path".'
                % (_ERROR_REPR.repr(event_ref), candidates)
            )
        return next(iter(found))

    def _resolve_event_path(self, event):
        if event.startswith("/") or event.startswith("."):
            try:
                return self._position_resolve_event(event)
            except (ModelValueError, ModelLookupError) as err:
                # ModelValueError/ModelLookupError: the user-supplied
                # state-relative path is malformed or absent from the current
                # position.
                raise SimulationRuntimeEventError(str(err)) from err
        try:
            return self._machine_resolve_event(event)
        except (ModelValueError, ModelLookupError):
            # ModelValueError/ModelLookupError: the path was not a valid full
            # event path, so try the current position before surfacing a single
            # public diagnostic.
            try:
                return self._position_resolve_event(event)
            except (ModelValueError, ModelLookupError) as err:
                # ModelValueError/ModelLookupError: the same user-supplied
                # path also failed position-relative lookup.
                if len(self.leaves) > 1:
                    # With several active leaves the name was resolved from
                    # each of them, and the error says why it led nowhere or
                    # to several events; the fallback wording would bury it.
                    raise SimulationRuntimeEventError(str(err)) from err
                raise SimulationRuntimeEventError(
                    "Cannot resolve event path %r: "
                    "failed with both StateMachine.resolve_event and State.resolve_event. "
                    "Last error: %s" % (event, err)
                ) from err

    def _parse_event(self, event):
        if isinstance(event, str):
            return self._resolve_event_path(event)
        if hasattr(event, "path_name") and isinstance(event.path_name, str):
            return self._machine_event_object(event.path_name, event)
        raise SimulationRuntimeEventError(
            "Unsupported event input %r of type %r; "
            "expected an event path string or an object with a path_name."
            % (event, type(event))
        )

    def _machine_event_object(self, path_name, event):
        try:
            return self._machine_resolve_event(path_name)
        except (ModelValueError, ModelLookupError) as err:
            # ModelValueError/ModelLookupError: the caller supplied an event
            # object whose canonical path is malformed or absent from this
            # runtime's state machine.
            raise SimulationRuntimeEventError(
                "Event object %r does not resolve in this runtime: %s" % (event, err)
            ) from err

    def _normalize_events(self, events):
        if events is None:
            return ()
        if isinstance(events, str):
            events = [events]
        elif hasattr(events, "path_name"):
            raise SimulationRuntimeEventError(
                "Unsupported event input %r of type %r; "
                "expected an event path string, an event object, or an iterable "
                "of those values." % (events, type(events))
            )
        try:
            items = list(events)
        except TypeError as err:
            # TypeError: list(events) raises when the caller supplied a
            # non-iterable object that is not one of the supported single-event
            # shapes.
            raise SimulationRuntimeEventError(
                "Unsupported event input %r of type %r; "
                "expected an event path string, an event object, or an iterable "
                "of those values." % (events, type(events))
            ) from err
        return tuple(self._parse_event(item) for item in items)

    # -- actions and guards ----------------------------------------------------

    def _execute_func(
        self,
        func,
        vars_,
        is_validation_mode=False,
        execution_state_path=None,
        active_leaf_path=None,
    ):
        if func["kind"] != "abstract":
            getattr(self, func["method"])(vars_)
            return
        if is_validation_mode:
            return
        if execution_state_path is None:
            execution_state_path = func["context_state_path"]
        if active_leaf_path is None:
            active_leaf_path = execution_state_path
        ctx = ReadOnlyExecutionContext(
            state_path=execution_state_path,
            vars=dict(vars_),
            action_name=func["action_name"],
            action_stage=func["action_stage"],
            active_leaf=active_leaf_path,
            call_stage=func["call_stage"],
            abstract_target=func["abstract_target"],
            named_ref=func["named_ref"],
            parameters=self.parameters,
            inputs=self._context_inputs(),
            configuration=_position_text(_position_of_stack(self._root_stack)),
        )
        old_vars = self._vars
        old_variables = self.variables
        self._vars = vars_
        self.variables = self._vars
        try:
            getattr(self, func["hook_method"])(ctx)
        finally:
            self._vars = old_vars
            self.variables = old_variables

    def _transition_matches_event(self, transition, d_events):
        if transition.event is None:
            return True
        return transition.event in d_events

    def _transition_matches_guard(self, transition, vars_):
        if transition.guard is None:
            return True
        return bool(getattr(self, transition.guard)(vars_))

    def _execute_transition_effect(self, transition, vars_, is_validation_mode=False):
        if transition.effect is not None:
            getattr(self, transition.effect)(vars_)

    def _run_owner_plain_after(self, owner, vars_, is_validation_mode):
        for func in owner.plain_after:
            self._execute_func(func, vars_, is_validation_mode=is_validation_mode)

    def _consume_plain_before_if_pending(self, frame, vars_, is_validation_mode=False):
        if not frame.plain_before_pending:
            return
        owner = frame.state.parent if frame.state.is_region else frame.state
        for func in owner.plain_before:
            self._execute_func(func, vars_, is_validation_mode=is_validation_mode)
        frame.plain_before_pending = False

    # -- aspects ---------------------------------------------------------------

    def _run_leaf_during(self, state, vars_, is_validation_mode=False):
        scopes = []
        scope = state.parent
        while scope is not None:
            scopes.append(scope)
            scope = scope.parent
        scopes.reverse()
        if not state.is_pseudo:
            for scope in scopes:
                entry = self._ledger.setdefault(scope.path, [False, False])
                if not entry[0]:
                    entry[0] = True
                    for func in scope.aspect_before:
                        wrapped = (
                            state.path
                            if is_validation_mode
                            else self._wrapped_state_path(scope)
                        )
                        self._execute_func(
                            func,
                            vars_,
                            is_validation_mode=is_validation_mode,
                            execution_state_path=wrapped,
                            active_leaf_path=wrapped,
                        )
        for func in state.plain_durings:
            self._execute_func(
                func,
                vars_,
                is_validation_mode=is_validation_mode,
                execution_state_path=state.path,
                active_leaf_path=state.path,
            )
        if not state.is_pseudo:
            for scope in scopes:
                self._ledger[scope.path][1] = True

    def _wrapped_state_path(self, scope):
        stack, index = _find_frame_in(self._root_stack, scope)
        while True:
            frame = stack[index]
            if frame.branches is not None and len(frame.branches) == 1:
                stack, index = frame.branches[0].stack, 0
            elif (frame.state.is_region or frame.branches is None) and index + 1 < len(
                stack
            ):
                index += 1
            else:
                break
        return stack[index].state.path

    def _flush_after_aspects(self, vars_, is_validation_mode, prefix=()):
        scopes, _ = self._model()
        owed = [
            path
            for path, entry in self._ledger.items()
            if entry[1] and path[: len(prefix)] == prefix
        ]
        for path in sorted(owed, key=lambda item: (-len(item), item)):
            self._ledger[path][1] = False
            scope = scopes[".".join(path)]
            for func in scope.aspect_after:
                wrapped = (
                    scope.path
                    if is_validation_mode
                    else self._wrapped_state_path(scope)
                )
                self._execute_func(
                    func,
                    vars_,
                    is_validation_mode=is_validation_mode,
                    execution_state_path=wrapped,
                    active_leaf_path=wrapped,
                )

    @staticmethod
    def _copy_ledger(ledger):
        return {path: list(entry) for path, entry in ledger.items()}

    # -- entering states and groups -------------------------------------------------

    def _enter_state(self, stack, state, vars_, d_events, is_validation_mode=False):
        stack.append(_Frame(state, "active"))
        if self._is_no_outgoing_pseudo(state):
            # This source has no control edge to execute. Keep the frame so the
            # public cycle can report a stuttering Delta, but do not run any
            # standalone lifecycle action before that classification.
            return
        for func in state.on_enters:
            self._execute_func(func, vars_, is_validation_mode=is_validation_mode)
        if state.is_leaf_state:
            self._run_leaf_during(state, vars_, is_validation_mode=is_validation_mode)
            stack[-1].mode = "after_entry"
        else:
            stack[-1].mode = "init_wait"
            stack[-1].plain_before_pending = True
            if state.regions:
                stack[-1].branches = [
                    _Branch(region, []) for region in state.regions.values()
                ]

    def _attempt_init_transition(
        self, stack, vars_, d_events, is_validation_mode=False
    ):
        state = stack[-1].state
        transition = self._select_valid_candidate(
            stack,
            vars_,
            d_events,
            state.init_transitions,
            self._validate_initial_transition,
        )
        if transition is None:
            return False
        self._execute_initial_transition_on_context(
            stack,
            vars_,
            transition,
            d_events,
            is_validation_mode=is_validation_mode,
        )
        return True

    def _current_outer(self):
        return self._outer_chain[-1] if self._outer_chain else None

    def _init_group(self, stack, vars_, d_events, is_validation_mode=False, outer=None):
        self._init_depth += 1
        try:
            if self._init_depth > self._DFS_STRUCTURAL_DEPTH_LIMIT:
                limit = self._DFS_STRUCTURAL_DEPTH_LIMIT
                raise SimulationRuntimeDfsError(
                    "Group initialization nested deeper than the structural safety "
                    "limit (%s) within one cycle; the state machine either "
                    "enters more than %s groups inside one another or one "
                    "after another in the same cycle, or re-enters a group without "
                    "bound." % (limit, limit)
                )
            frame = stack[-1]
            pending = frame.plain_before_pending
            for index, branch in enumerate(frame.branches):
                region_frame = _Frame(branch.region, "init_wait", pending)
                branch.stack = [region_frame]
                run = _Run(is_validation_mode=is_validation_mode)
                self._outer_chain.append(_Outer(stack, index, outer))
                try:
                    outcome = self._advance_stack(branch.stack, vars_, d_events, run)
                finally:
                    self._outer_chain.pop()
                if outcome not in (_STABLE, _REGION_DONE):
                    return False
                self._flush_after_aspects(vars_, is_validation_mode, branch.region.path)
                # The first non-pseudo child entered anywhere in the group consumes
                # the owner's plain ``during before`` boundary actions.
                pending = region_frame.plain_before_pending
            frame.plain_before_pending = False
            self._finish_group_advance(frame, vars_, is_validation_mode, entered=True)
            return True
        except RecursionError:
            # RecursionError: the interpreter's call stack ran out somewhere
            # below this group entry. Only note how deep the entries were
            # nested, so that the cycle can say so; nothing else is safe to do
            # this close to the limit.
            if self._overflow_depth is None:
                self._overflow_depth = self._init_depth
            raise
        finally:
            self._init_depth -= 1

    def _finish_group_advance(self, frame, vars_, is_validation_mode, entered=False):
        if all(branch.status == "done" for branch in frame.branches):
            self._run_owner_plain_after(frame.state, vars_, is_validation_mode)
            frame.mode = "post_child_exit"
        else:
            frame.mode = "after_entry" if entered else "active"

    def _advance_owner(self, stack, vars_, d_events, run):
        frame = stack[-1]
        if frame.mode == "init_wait":
            ok = self._init_group(
                stack,
                vars_,
                d_events,
                is_validation_mode=run.is_validation_mode,
                outer=self._current_outer(),
            )
            return _CONTINUE if ok else _FAILED
        for index, branch in enumerate(frame.branches):
            if branch.status == "done":
                continue
            if branch.status == "pending":
                # Only a hot start leaves an owner at work with a region that
                # has not been initialized: it gets its turn like the others.
                branch.stack = [_Frame(branch.region, "init_wait")]
            self._outer_chain.append(_Outer(stack, index, self._current_outer()))
            try:
                outcome = self._advance_stack(branch.stack, vars_, d_events, run)
            finally:
                self._outer_chain.pop()
            if outcome not in (_STABLE, _REGION_DONE):
                return _FAILED
            self._flush_after_aspects(vars_, run.is_validation_mode, branch.region.path)
        self._finish_group_advance(frame, vars_, run.is_validation_mode)
        return _CONTINUE if frame.mode == "post_child_exit" else _STABLE

    # -- judging a candidate ------------------------------------------------------------

    def _continuation_viable(self, branch_stack, vars_, d_events, outer):
        owner_stack = _clone_stack(outer.stack)
        owner_frame = owner_stack[-1]
        owner_frame.branches[outer.index].stack = _clone_stack(branch_stack)
        if any(branch.status != "done" for branch in owner_frame.branches):
            return True
        sim_vars = dict(vars_)
        self._run_owner_plain_after(owner_frame.state, sim_vars, True)
        owner_frame.mode = "post_child_exit"
        return self._owner_can_continue(owner_stack, sim_vars, d_events, outer.parent)

    def _owner_can_continue(self, owner_stack, vars_, d_events, outer):
        signature = _create_execution_signature(owner_stack, vars_)
        key = (signature, self._enclosing_shapes(outer))
        # A group only hands control back inside a check started by
        # _check_candidate.
        self._memo_deps[-1].add(key)
        # Seeing this position again is the loop that the starting points of
        # the checks would find one round later; stopping here keeps the
        # nesting one level lower.
        if key in self._continuation_trail:
            raise _SimulationRuntimeLivelockError((signature, signature))
        self._continuation_trail.append(key)
        try:
            memo_key = self._memo_key(("continuation",), owner_stack, vars_, outer)
            viable = self._memo_get(memo_key)
            if viable is None:
                self._memo_deps.append(set())
                try:
                    viable = self._validation_search_reaches_stable(
                        owner_stack, vars_, d_events, outer=outer
                    )
                finally:
                    positions = self._memo_close()
                self._memo_put(memo_key, viable, positions)
            return viable
        finally:
            self._continuation_trail.pop()

    @staticmethod
    def _enclosing_shapes(outer):
        shapes = []
        while outer is not None:
            # The branch being examined is described by its own stack; what the
            # enclosing stack still holds in that slot may be out of date.
            shapes.append(_stack_shape(outer.stack, outer.index))
            outer = outer.parent
        return tuple(shapes)

    def _select_valid_candidate(self, stack, vars_, d_events, transitions, validator):
        loop_error = None
        for transition in transitions:
            try:
                accepted = self._check_candidate(
                    stack, vars_, d_events, transition, validator=validator
                )
            except _SimulationRuntimeLivelockError as error:
                # _SimulationRuntimeLivelockError: _check_candidate proved a loop
                # with no stable continuation; a later candidate may still work.
                loop_error = error
                continue
            if accepted:
                return transition
        if loop_error is not None:
            raise loop_error
        return None

    def _check_candidate(self, stack, vars_, d_events, transition, validator=None):
        if not self._transition_matches_event(transition, d_events):
            return False
        if not self._transition_matches_guard(transition, vars_):
            return False
        if validator is not None:
            memo_key = self._memo_key(
                ("candidate", stack[-1].state.path, transition.key),
                stack,
                vars_,
                self._current_outer(),
            )
            # A check that is under way owns the point it started from. Coming
            # back to that point further in is a loop, whichever candidate is
            # asked about there: taking it for real would arrive here again and
            # choose the same way.
            origin = ("origin",) + memo_key[1:]
            if self._memo_deps:
                self._memo_deps[-1].add(origin)
            if origin in self._continuation_trail:
                # A region is not a state: a loop met while it picks its
                # initial transition is reported at its owner.
                where = stack
                if stack[-1].state.is_region:
                    where = self._current_outer().stack
                signature = _create_execution_signature(where, vars_)
                raise _SimulationRuntimeLivelockError((signature, signature))
            accepted = self._memo_get(memo_key)
            if accepted is None:
                self._continuation_trail.append(origin)
                self._memo_deps.append(set())
                try:
                    accepted = validator(stack, vars_, transition, d_events)
                finally:
                    positions = self._memo_close()
                    self._continuation_trail.pop()
                self._memo_put(memo_key, accepted, positions)
            if not accepted:
                return False
        return True

    def _memo_key(self, tag, stack, vars_, outer):
        enclosing = []
        while outer is not None:
            enclosing.append(_stack_shape(outer.stack, outer.index))
            outer = outer.parent
        ledger = tuple(
            sorted((path, entry[0], entry[1]) for path, entry in self._ledger.items())
        )
        return (
            tag,
            _stack_shape(stack),
            tuple(sorted(vars_.items())),
            tuple(enclosing),
            ledger,
        )

    def _memo_get(self, key):
        entry = self._memo.get(key)
        if entry is None:
            return None
        result, positions, on_trail = entry
        if positions.intersection(self._continuation_trail) != on_trail:
            return None
        if self._memo_deps:
            self._memo_deps[-1].update(positions)
        return result

    def _memo_close(self):
        positions = self._memo_deps.pop()
        if self._memo_deps:
            self._memo_deps[-1].update(positions)
        return positions

    def _memo_put(self, key, result, positions):
        self._memo[key] = (
            result,
            frozenset(positions),
            frozenset(positions.intersection(self._continuation_trail)),
        )

    # -- transitions -----------------------------------------------------------------

    def _execute_initial_transition_on_context(
        self, stack, vars_, transition, d_events, is_validation_mode=False
    ):
        composite_frame = stack[-1]
        self._execute_transition_effect(
            transition, vars_, is_validation_mode=is_validation_mode
        )
        target_state = transition.target
        if not target_state.is_pseudo:
            self._consume_plain_before_if_pending(
                composite_frame, vars_, is_validation_mode=is_validation_mode
            )
        self._enter_state(
            stack,
            target_state,
            vars_,
            d_events,
            is_validation_mode=is_validation_mode,
        )
        if composite_frame in stack:
            composite_frame.mode = "active"

    def _validate_initial_transition(self, stack, vars_, transition, d_events):
        sim_stack = _clone_stack(stack)
        sim_vars = dict(vars_)
        saved = self._ledger
        self._ledger = self._copy_ledger(saved)
        try:
            self._execute_initial_transition_on_context(
                sim_stack, sim_vars, transition, d_events, is_validation_mode=True
            )
            return self._validation_search_reaches_stable(
                sim_stack,
                sim_vars,
                d_events,
                trail=(_create_execution_signature(stack, vars_),),
            )
        finally:
            self._ledger = saved

    def _finalize_exit_to_parent(self, stack, vars_, is_validation_mode=False):
        if not stack:
            return True
        parent = stack[-1].state
        if parent.is_region:
            # The child left through ``[*]`` directly under a region: the region
            # is done. It has no ``during after`` action to run.
            stack[-1].mode = "post_child_exit"
            return False
        if parent.is_root_state:
            for func in parent.plain_after:
                self._execute_func(func, vars_, is_validation_mode=is_validation_mode)
            for func in parent.on_exits:
                self._execute_func(func, vars_, is_validation_mode=is_validation_mode)
            stack.clear()
            return True
        for func in parent.plain_after:
            self._execute_func(func, vars_, is_validation_mode=is_validation_mode)
        stack[-1].mode = "post_child_exit"
        return False

    def _execute_transition_on_context(
        self, stack, vars_, transition, d_events, is_validation_mode=False
    ):
        current_state = stack[-1].state
        for func in current_state.on_exits:
            self._execute_func(func, vars_, is_validation_mode=is_validation_mode)
        self._execute_transition_effect(
            transition, vars_, is_validation_mode=is_validation_mode
        )
        stack.pop()
        if transition.to_exit:
            if (
                current_state.is_pseudo
                and stack
                and not stack[-1].state.is_region
                and stack[-1].state is current_state.parent
                and stack[-1].plain_before_pending
            ):
                stack[-1].plain_before_pending = False
            return self._finalize_exit_to_parent(
                stack, vars_, is_validation_mode=is_validation_mode
            )
        target_state = transition.target
        if (
            current_state.is_pseudo
            and stack
            and stack[-1].state is current_state.parent
            and not target_state.is_pseudo
        ):
            self._consume_plain_before_if_pending(
                stack[-1], vars_, is_validation_mode=is_validation_mode
            )
        self._enter_state(
            stack,
            target_state,
            vars_,
            d_events,
            is_validation_mode=is_validation_mode,
        )
        return False

    def _select_transition(
        self,
        stack,
        vars_,
        d_events,
        validate_stoppable=True,
        force_validate=False,
    ):
        current_state = stack[-1].state
        validator = (
            self._validate_transition
            if validate_stoppable and (current_state.is_stoppable or force_validate)
            else None
        )
        return self._select_valid_candidate(
            stack, vars_, d_events, current_state.transitions_from, validator
        )

    def _validate_transition(self, stack, vars_, transition, d_events):
        saved = self._ledger
        self._ledger = self._copy_ledger(saved)
        try:
            sim_stack = _clone_stack(stack)
            sim_vars = dict(vars_)
            ended = self._execute_transition_on_context(
                sim_stack, sim_vars, transition, d_events, is_validation_mode=True
            )
            if ended:
                return True
            return self._validation_search_reaches_stable(
                sim_stack,
                sim_vars,
                d_events,
                trail=(_create_execution_signature(stack, vars_),),
            )
        finally:
            self._ledger = saved

    def _check_structural_limit(self, stack):
        if len(stack) > self._DFS_STRUCTURAL_DEPTH_LIMIT:
            raise SimulationRuntimeDfsError(
                "Speculative DFS exceeded the structural stack-depth safety limit "
                "(%s) without reaching a stoppable state or pruning; "
                "the state machine likely contains an invalid unbounded nesting chain."
                % (self._DFS_STRUCTURAL_DEPTH_LIMIT,)
            )

    def _check_step_limit(self, steps_taken):
        if steps_taken >= self._DFS_STEP_LIMIT:
            raise SimulationRuntimeDfsError(
                "Speculative DFS exceeded the step safety limit "
                "(%s) without reaching a stoppable state or pruning; "
                "the state machine likely contains an invalid unbounded pseudo-state "
                "or transition chain." % (self._DFS_STEP_LIMIT,)
            )

    # -- searching for a stable position ---------------------------------------------

    def _validation_search_reaches_stable(
        self, stack, vars_, d_events, trail=(), outer=_UNSET
    ):
        saved = self._ledger
        try:
            return self._search_stable_continuation(
                stack, vars_, d_events, trail=trail, outer=outer
            )
        finally:
            self._ledger = saved

    def _search_stable_continuation(
        self, stack, vars_, d_events, trail=(), outer=_UNSET
    ):
        if outer is _UNSET:
            outer = self._current_outer()
        original_ledger = self._ledger
        worklist = [
            (
                _clone_stack(stack),
                dict(vars_),
                False,
                trail,
                self._copy_ledger(original_ledger),
            )
        ]
        loop_error = None
        seen_signatures = set()
        steps_taken = 0
        while worklist:
            current_stack, current_vars, current_ended, trail, current_ledger = (
                worklist.pop()
            )
            if current_ended:
                stack.clear()
                vars_.clear()
                vars_.update(current_vars)
                return True
            self._check_structural_limit(current_stack)
            signature = _create_execution_signature(current_stack, current_vars)
            if signature in trail:
                loop_error = _SimulationRuntimeLivelockError(
                    trail[trail.index(signature) :] + (signature,)
                )
                continue
            if signature in seen_signatures:
                continue
            seen_signatures.add(signature)
            next_trail = trail + (signature,)
            self._check_step_limit(steps_taken)
            steps_taken += 1
            frame = current_stack[-1]
            state = frame.state
            if state.is_region:
                # Only a finished region can be on top of a searched stack: its
                # initial transition already ran before the search started.
                self._ledger = self._copy_ledger(current_ledger)
                try:
                    viable = self._continuation_viable(
                        current_stack, current_vars, d_events, outer
                    )
                except _SimulationRuntimeLivelockError as error:
                    # _SimulationRuntimeLivelockError: the owner's continuation
                    # leads back to the same position. That kills this path
                    # only; other worklist items may still succeed.
                    loop_error = error
                    continue
                if viable:
                    stack[:] = current_stack
                    vars_.clear()
                    vars_.update(current_vars)
                    return True
                continue
            if frame.branches is not None and frame.mode == "init_wait":
                next_stack = _clone_stack(current_stack)
                next_vars = dict(current_vars)
                self._ledger = self._copy_ledger(current_ledger)
                try:
                    initialized = self._init_group(
                        next_stack,
                        next_vars,
                        d_events,
                        is_validation_mode=True,
                        outer=outer,
                    )
                except _SimulationRuntimeLivelockError as error:
                    # _SimulationRuntimeLivelockError: a region's own initial
                    # candidates loop without a stable exit. That only kills
                    # this path; other items of the worklist may still succeed.
                    loop_error = error
                    continue
                if initialized:
                    worklist.append(
                        (next_stack, next_vars, False, next_trail, self._ledger)
                    )
                continue
            if frame.branches is not None and frame.mode in ("active", "after_entry"):
                # Every working region rests on a stable leaf.
                stack[:] = current_stack
                vars_.clear()
                vars_.update(current_vars)
                return True
            if state.is_leaf_state and frame.mode == "after_entry":
                next_stack = _clone_stack(current_stack)
                next_vars = dict(current_vars)
                self._ledger = self._copy_ledger(current_ledger)
                next_stack[-1].mode = "active"
                if state.is_stoppable:
                    stack[:] = next_stack
                    vars_.clear()
                    vars_.update(next_vars)
                    return True
                worklist.append(
                    (next_stack, next_vars, False, next_trail, self._ledger)
                )
                continue
            if state.is_leaf_state:
                # Stoppable leaf entries returned above; only pseudo routing
                # remains, and a pseudo with no enabled edge is a dead end.
                for transition in reversed(state.transitions_from):
                    if not self._check_candidate(
                        current_stack, current_vars, d_events, transition
                    ):
                        continue
                    next_stack = _clone_stack(current_stack)
                    next_vars = dict(current_vars)
                    self._ledger = self._copy_ledger(current_ledger)
                    next_ended = self._execute_transition_on_context(
                        next_stack,
                        next_vars,
                        transition,
                        d_events,
                        is_validation_mode=True,
                    )
                    worklist.append(
                        (next_stack, next_vars, next_ended, next_trail, self._ledger)
                    )
                continue
            if frame.mode == "init_wait":
                for transition in reversed(state.init_transitions):
                    if not self._check_candidate(
                        current_stack, current_vars, d_events, transition
                    ):
                        continue
                    next_stack = _clone_stack(current_stack)
                    next_vars = dict(current_vars)
                    self._ledger = self._copy_ledger(current_ledger)
                    self._execute_initial_transition_on_context(
                        next_stack,
                        next_vars,
                        transition,
                        d_events,
                        is_validation_mode=True,
                    )
                    worklist.append(
                        (next_stack, next_vars, False, next_trail, self._ledger)
                    )
                continue
            # Every other frame in the search is a parent whose child exited.
            for transition in reversed(state.transitions_from):
                if not self._check_candidate(
                    current_stack, current_vars, d_events, transition
                ):
                    continue
                next_stack = _clone_stack(current_stack)
                next_vars = dict(current_vars)
                self._ledger = self._copy_ledger(current_ledger)
                next_ended = self._execute_transition_on_context(
                    next_stack,
                    next_vars,
                    transition,
                    d_events,
                    is_validation_mode=True,
                )
                worklist.append(
                    (next_stack, next_vars, next_ended, next_trail, self._ledger)
                )
        if loop_error is not None:
            raise loop_error
        return False

    # -- one cycle ---------------------------------------------------------------------------

    def _initialize_context(self, stack, vars_, d_events, is_validation_mode=False):
        stack.clear()
        if not is_validation_mode:
            self._root_stack = stack
        self._enter_state(
            stack,
            self._model()[1],
            vars_,
            d_events,
            is_validation_mode=is_validation_mode,
        )
        return len(stack) == 0

    def _run_cycle_on_context(
        self,
        stack,
        vars_,
        d_events,
        validate_post_child_exit=True,
        is_validation_mode=False,
    ):
        run = _Run(
            is_validation_mode=is_validation_mode,
            validate_post_child_exit=validate_post_child_exit,
        )
        self._outer_chain = []
        if not is_validation_mode:
            self._root_stack = stack
        outcome = self._advance_stack(stack, vars_, d_events, run)
        if outcome == _STABLE:
            # Work is always followed by a stable boundary, so a cycle that
            # ends the machine owes no aspect.
            self._flush_after_aspects(vars_, is_validation_mode)
            return True, False
        if outcome == _ENDED:
            return True, True
        return False, False

    def _advance_stack(self, stack, vars_, d_events, run):
        is_validation_mode = run.is_validation_mode
        validate_post_child_exit = run.validate_post_child_exit
        while True:
            signature = _create_execution_signature(stack, vars_)
            if signature in run.seen_signatures:
                return _FAILED
            run.seen_signatures.add(signature)
            self._check_structural_limit(stack)
            self._check_step_limit(run.steps_taken)
            frame = stack[-1]
            state = frame.state
            if state.is_region:
                if frame.mode == "post_child_exit":
                    return _REGION_DONE
                progressed = self._attempt_init_transition(
                    stack, vars_, d_events, is_validation_mode=is_validation_mode
                )
                run.steps_taken += 1
                if not progressed:
                    return _FAILED
                continue
            if self._is_no_outgoing_pseudo(state):
                return _FAILED
            if frame.branches is not None and frame.mode == "after_entry":
                frame.mode = "active"
                return _STABLE
            if frame.branches is not None and frame.mode != "post_child_exit":
                outcome = self._advance_owner(stack, vars_, d_events, run)
                run.steps_taken += 1
                if outcome == _CONTINUE:
                    continue
                return outcome
            if state.is_leaf_state:
                if frame.mode == "after_entry":
                    frame.mode = "active"
                    if state.is_stoppable:
                        return _STABLE
                    run.steps_taken += 1
                    continue
                transition = self._select_transition(
                    stack,
                    vars_,
                    d_events,
                    force_validate=not state.is_stoppable,
                )
                if transition is not None:
                    ended = self._execute_transition_on_context(
                        stack,
                        vars_,
                        transition,
