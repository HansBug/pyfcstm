def int ready = 0;
def int ticks = 0;
state Plant {
    [*] -> Job;
    state Job {
        region Count {
            [*] -> Counting;
            state Counting { during { ticks = ticks + 1; } }
        }
        region Gate {
            [*] -> Open : if [ready > 0];
            state Open;
        }
    }
}
