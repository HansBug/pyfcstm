def int a = 0;
def int b = 0;
def int order = 0;
state Workflow {
    event ADone;
    event BDone;
    event Cancel;
    [*] -> Job;
    state Job {
        exit { order = order * 10 + 3; }
        region A {
            [*] -> Working;
            state Working {
                during { a = a + 1; }
                exit { order = order * 10 + 1; }
            }
            Working -> [*] : /ADone;
        }
        region B {
            [*] -> Working;
            state Working {
                during { b = b + 1; }
                exit { order = order * 10 + 2; }
            }
            Working -> [*] : /BDone;
        }
    }
    state Idle;
    Job -> Idle;
    !Job -> Idle : /Cancel;
}
