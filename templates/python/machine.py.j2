{% raw %}    def _cycle(self, events=None):
        """
        Advance the state machine by one cycle.

        :param events: Resolved event paths of this cycle.
        :type events: Tuple[str, ...]
        :return: ``None``.
        :rtype: None
        """
        self._last_cycle_was_delta = False
        if self._ended:
            return None
        d_events = set(events or ())
        self._outer_chain = []
        self._memo = {}
        self._memo_deps = []
        self._overflow_depth = None

        snapshot_stack = _clone_stack(self._stack)
        snapshot_vars = dict(self._vars)
        snapshot_entered_root = self._entered_root
        snapshot_ended = self._ended

        validation_stack = _clone_stack(snapshot_stack)
        validation_vars = dict(snapshot_vars)
        validation_entered_root = snapshot_entered_root
        validation_ended = snapshot_ended

        self._ledger = {}
        try:
            if not validation_entered_root:
                validation_ended = self._initialize_context(
                    validation_stack,
                    validation_vars,
                    d_events,
                    is_validation_mode=True,
                )
                validation_entered_root = True
            success, validation_ended = self._run_cycle_on_context(
                validation_stack,
                validation_vars,
                d_events,
                is_validation_mode=True,
            )
        except RecursionError as err:
            if self._overflow_depth is None or self._overflow_depth < 2:
                raise
            raise SimulationRuntimeDfsError(
                "The call stack was exhausted with group entries nested "
                "%s deep within one cycle; the state machine "
                "likely re-enters a group without bound, or the caller's own "
                "stack was already deep." % (self._overflow_depth,)
            ) from err

        delta = not success
        if success:
            sim_stack = _clone_stack(snapshot_stack)
            sim_vars = dict(snapshot_vars)
            sim_entered_root = snapshot_entered_root
            sim_ended = snapshot_ended
            self._ledger = {}
            if not sim_entered_root:
                sim_ended = self._initialize_context(sim_stack, sim_vars, d_events)
                sim_entered_root = True
            success, sim_ended = self._run_cycle_on_context(
                sim_stack, sim_vars, d_events
            )
            if not success:
                delta = True

        if delta:
            self._stack = snapshot_stack
            self._vars = snapshot_vars
            self._entered_root = snapshot_entered_root
            self._ended = snapshot_ended
            self._last_cycle_was_delta = True
        else:
            self._stack = [] if sim_ended else sim_stack
            self._vars = sim_vars
            self._entered_root = sim_entered_root
            self._ended = sim_ended

