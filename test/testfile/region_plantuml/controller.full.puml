@startuml
hide empty description

skinparam state {
  BackgroundColor<<pseudo>> LightGray
  BackgroundColor<<composite>> LightBlue
  BorderColor<<pseudo>> Gray
  FontStyle<<pseudo>> italic
}

legend top left
|= Variable |= Type |= Initial Value |= Role |
| fault | int | N/A | input |
| requested | int | N/A | input |
| permit | int | 0 | control |
| motor | int | 0 | output |
endlegend

state "Controller" as controller <<composite>> {
    state "Idle" as controller__idle
    controller__idle : during {\n    motor = 0;\n}
    state "Running" as controller__running <<composite>> {
        state "region 1: Safety" as controller__running__safety <<region>> #line.dashed {
            state "Normal" as controller__running__safety__normal
            controller__running__safety__normal : during {\n    if [fault != 0] {\n        permit = 0;\n    }\n}
            state "Tripped" as controller__running__safety__tripped
            [*] --> controller__running__safety__normal
            controller__running__safety__normal --> controller__running__safety__tripped : fault != 0
        }
        controller__running__safety : >> during before {\n    permit = 1;\n}
        --
        state "region 2: Motion" as controller__running__motion <<region>> #line.dashed {
            state "Off" as controller__running__motion__off
            controller__running__motion__off : during {\n    motor = 0;\n}
            state "On" as controller__running__motion__on
            controller__running__motion__on : during {\n    if [active("Controller.Running.Safety.Tripped")] {\n        motor = 0;\n    } else {\n        motor = 1;\n    }\n}
            [*] --> controller__running__motion__off
            controller__running__motion__off --> controller__running__motion__on : permit != 0 && requested != 0
            controller__running__motion__on --> controller__running__motion__off : active("Controller.Running.Safety.Tripped")
            controller__running__motion__on --> controller__running__motion__off : Kick
        }
    }
    controller__running : enter {\n    permit = 0;\n}
    controller__running --> controller__idle : Stop
    [*] --> controller__idle
    controller__idle --> controller__running : Start
}
[*] --> controller
controller --> [*]
@enduml