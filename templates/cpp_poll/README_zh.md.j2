{% set state_items = model.walk_states() | list -%}
{% set event_ns = namespace(items=[]) -%}
{% for state in state_items -%}
{% for event in state.events.values() -%}
{% set event_ns.items = event_ns.items + [event.path_name] -%}
{% endfor -%}
{% endfor -%}
{% set abstract_ns = namespace(rows=[]) -%}
{% set action_scan = namespace(items=[]) -%}
{% for scan_state in state_items -%}
{% for scan_group in [
    scan_state.list_on_enters(with_ids=True),
    scan_state.list_on_durings(aspect=None, with_ids=True),
    scan_state.list_on_exits(with_ids=True),
    scan_state.list_on_durings(aspect='before', with_ids=True),
    scan_state.list_on_durings(aspect='after', with_ids=True),
    scan_state.list_on_during_aspects(aspect='before', with_ids=True),
    scan_state.list_on_during_aspects(aspect='after', with_ids=True),
] -%}
{% for _, scan_item in scan_group -%}
{% set action_scan.items = action_scan.items + [scan_item] -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% set action_ref_hop_limit = (action_scan.items | length) + 1 -%}
{% for state in state_items -%}
{% for group in [
    state.list_on_enters(with_ids=True),
    state.list_on_durings(aspect=None, with_ids=True),
    state.list_on_exits(with_ids=True),
    state.list_on_durings(aspect='before', with_ids=True),
    state.list_on_durings(aspect='after', with_ids=True),
    state.list_on_during_aspects(aspect='before', with_ids=True),
    state.list_on_during_aspects(aspect='after', with_ids=True),
] -%}
{% for _, item in group -%}
{% set resolved = namespace(item=item) -%}
{% for _ in range(action_ref_hop_limit) -%}
{% if resolved.item.ref is not none -%}
{% set resolved.item = resolved.item.ref -%}
{% endif -%}
{% endfor -%}
{% if resolved.item.is_abstract and resolved.item.func_name not in abstract_ns.rows | map(attribute='func_name') | list -%}
{% set abstract_ns.rows = abstract_ns.rows + [{
    'func_name': resolved.item.func_name,
    'hook_name': hook_field_id_name(resolved.item),
    'owner_path': action_owner_path(resolved.item),
    'stage': resolved.item.stage,
    'aspect': resolved.item.aspect,
}] -%}
{% endif -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% set m = machine_class_name(model) -%}
{% set a = machine_macro_name(model) -%}

# {{ m }}

本目录提供自包含的 C++98 封装及 C99 执行内核。将应用代码放在 `app.cpp` 中；模型行为变化时修改 DSL 并重新生成状态机文件。生成程序不依赖 Python 或第三方运行时库。

**生成文件：**通过 `machine.hpp` 和 `MachineWrapper`接入应用。`machine.c` 和 `machine.cpp` 是生成的实现文件。`README.md` 提供对应英文指南。依次阅读[快速开始](#quick-start)、[接入说明](#integration)、[恢复](#recovery)和[编译](#build)。

<a id="quick-start"></a>

## 快速开始

将下面的完整程序保存为 `app.cpp`。程序按模型声明配置参数、连接输入并注册抽象动作{% if event_ns.items %}，同时安装完整事件查询表{% endif %}。{% if model.dynamic_inputs or model.static_inputs %}数值 `1` 仅用于演示，请替换为适合当前模型的读数和配置。{% endif %}动作回调打印观察值，可将其函数体替换为应用逻辑。初始化一次后，由应用调度器对同一个实例重复调用周期入口。

<!-- example:quick-start -->

```cpp
#include "machine.hpp"
#include <stdio.h>
#include <string.h>

typedef pyfcstm_generated::{{ m }}_cpp_poll::MachineWrapper Wrapper;

typedef struct AppData {
    Wrapper *owner;
    Wrapper::Inputs inputs;
    int hook_calls;
    int event_active;
} AppData;

{% for item in model.dynamic_inputs.values() %}static int app_read_{{ item.name | readonly_value_identifier }}(void *user_data, {% if item.type == 'int' %}Wrapper::Int{% else %}double{% endif %} *value)
{
    AppData *data = (AppData *)user_data;
    /* Replace this lookup with your sensor/driver call; return 0 on failure. */
    *value = data->inputs.{{ item.name | readonly_value_identifier }};
    return 1;
}

{% endfor %}{% if abstract_ns.rows %}static void app_action(Wrapper::Machine *machine, const Wrapper::ExecutionContext *ctx, void *user_data)
{
    AppData *data = (AppData *)user_data;
    (void)machine;
    ++data->hook_calls;
{% for item in model.dynamic_inputs.values() %}    printf("input {{ item.name }} = %.17g\n", (double)data->owner->get_input_{{ item.name | readonly_value_identifier }}());
{% endfor %}{% for item in model.static_inputs.values() %}    printf("param {{ item.name }} = %.17g\n", (double)data->owner->get_param_{{ item.name | readonly_value_identifier }}());
{% endfor %}    printf("action %d stage %d\n", (int)ctx->action_id, (int)ctx->action_stage_id);
}

{% endif %}{% if event_ns.items %}static int app_event(Wrapper::Machine *machine, const Wrapper::EventContext *ctx, void *user_data)
{
    const AppData *data = (const AppData *)user_data;
    (void)machine;
    (void)ctx;
    return data->event_active;
}
{% endif %}
int main(void)
{
    Wrapper::InitOptions options;
    AppData data;
    memset(&options, 0, sizeof(options));
    memset(&data, 0, sizeof(data));
{% for item in model.static_inputs.values() %}    options.parameters.{{ item.name | readonly_value_identifier }} = 1;
    options.parameters_present.{{ item.name | readonly_value_identifier }} = 1;
{% endfor %}    Wrapper machine(options);
    data.owner = &machine;
    if (machine.last_error()[0] != '\0') {
        fprintf(stderr, "%s\n", machine.last_error());
        return 1;
    }
{% if model.dynamic_inputs %}
    Wrapper::InputProvider provider;
    memset(&provider, 0, sizeof(provider));
{% for item in model.dynamic_inputs.values() %}    data.inputs.{{ item.name | readonly_value_identifier }} = 1;
    provider.read_{{ item.name | readonly_value_identifier }} = app_read_{{ item.name | readonly_value_identifier }};
{% endfor %}    machine.set_input_provider(&provider, &data);
{% endif %}{% if abstract_ns.rows %}
    Wrapper::Hooks hooks = {{ m | upper }}_HOOKS_INIT;
{% for row in abstract_ns.rows %}    hooks.{{ row['hook_name'] }} = app_action;
{% endfor %}    machine.set_hooks(&hooks, &data);
{% endif %}{% if event_ns.items %}
    Wrapper::EventChecks event_checks = {{ m | upper }}_EVENT_CHECKS_INIT;
{% for path in event_ns.items %}    event_checks.{{ event_check_field_id_name(path) }} = app_event;
{% endfor %}    machine.set_event_checks(&event_checks, &data);
    if (machine.last_error()[0] != '\0') {
        fprintf(stderr, "%s\n", machine.last_error());
        return 1;
    }
{% endif %}
    /* Keep this instance and AppData alive for subsequent host-scheduled cycles. */
    if (!machine.cycle()) {
        fprintf(stderr, "%s\n", machine.last_error());
        return 2;
    }
{% for item in model.static_inputs.values() %}    printf("param {{ item.name }} = %.17g\n", (double)machine.get_param_{{ item.name | readonly_value_identifier }}());
{% endfor %}{% for item in model.persistent_variables.values() %}    printf("{{ item.role.value }} {{ item.name }} = %.17g\n",
           (double)machine.vars()->{{ item.name | to_c_identifier }});
{% endfor %}    printf("hook calls = %d\n", data.hook_calls);
    /* Send committed outputs to your actuator/driver after success. */
    return 0;
}
