state Root {
    [*] -> Run;
    state Run {
        region Work {
            [*] -> Inner;
            state Inner {
                region X {
                    [*] -> x1;
                    state x1;
                    state x2;
                    x1 -> x2;
                }
                region Y {
                    [*] -> y1;
                    state y1;
                }
            }
        }
        region Aux {
            [*] -> a1;
            state a1;
        }
    }
}
