def int seq = 0;
state Root {
    event Stop;
    [*] -> P;
    state P {
        exit { seq = seq * 10 + 9; }
        region A {
            [*] -> Q;
            state Q {
                during after { seq = seq * 10 + 3; }
                exit { seq = seq * 10 + 4; }
                region X { [*] -> X1; state X1 { exit { seq = seq * 10 + 1; } } }
                region Y { [*] -> Y1; state Y1 { exit { seq = seq * 10 + 2; } } }
            }
        }
        region B { [*] -> W; state W { exit { seq = seq * 10 + 5; } } }
    }
    state Off;
    !P -> Off : /Stop;
}
