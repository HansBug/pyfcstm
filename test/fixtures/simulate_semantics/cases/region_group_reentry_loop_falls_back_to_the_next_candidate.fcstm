def int b = 0;
state Root {
    [*] -> Idle;
    state Idle;
    state P {
        region R {
            [*] -> X;
            state X { region RR { [*] -> p; pseudo state p; p -> [*]; } }
            X -> X effect { b = 3; }
        }
    }
    state Fallback;
    Idle -> P :: Go;
    Idle -> Fallback :: Go;
}
