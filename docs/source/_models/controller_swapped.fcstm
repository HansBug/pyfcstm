input int fault;
input int requested;
control int permit = 0;
output int motor = 0;

state Controller {
    event Start;
    event Stop;
    [*] -> Idle;
    state Idle { during { motor = 0; } }
    state Running {
        region Motion {
            [*] -> Off;
            state Off { during { motor = 0; } }
            state On { during { motor = 1; } }
            Off -> On : if [permit != 0 && requested != 0];
            On -> Off : if [permit == 0 || requested == 0];
        }
        region Safety {
            [*] -> Watching;
            state Watching {
                during {
                    if [fault != 0] { permit = 0; } else { permit = 1; }
                }
            }
        }
    }
    Idle -> Running : /Start;
    !Running -> Idle : /Stop;
}
