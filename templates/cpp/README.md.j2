## Quick Start

Save this complete program as `app.cpp`. Its setup follows this model’s declarations for parameters, inputs and abstract actions. {% if model.inputs or model.parameters %}Values of `1` are demonstration readings/configuration; replace them with values appropriate for this model.{% endif %} Action callbacks print observations; replace their bodies with application work. Initialize once and let your host scheduler call `cycle` repeatedly on the same instance.

<!-- example:quick-start -->

```cpp
#include "machine.hpp"
#include <stdio.h>
#include <string.h>

typedef pyfcstm_generated::{{ m }}_cpp::MachineWrapper Wrapper;

typedef struct AppData {
    Wrapper *owner;
    Wrapper::Inputs inputs;
    int hook_calls;
    int event_active;
} AppData;

{% for item in model.inputs.values() %}static int app_read_{{ item.name | readonly_value_identifier }}(void *user_data, {% if item.type == 'int' %}Wrapper::Int{% else %}double{% endif %} *value)
{
    AppData *data = (AppData *)user_data;
    /* Replace this lookup with your sensor/driver call; return 0 on failure. */
    *value = data->inputs.{{ item.name | readonly_value_identifier }};
    return 1;
}

{% endfor %}{% if abstract_ns.rows %}static void app_action(Wrapper::Machine *machine, const Wrapper::ExecutionContext *ctx, void *user_data)
{
    AppData *data = (AppData *)user_data;
    (void)machine;
    ++data->hook_calls;
{% for item in model.inputs.values() %}    printf("input {{ item.name }} = %.17g\n", (double)data->owner->get_input_{{ item.name | readonly_value_identifier }}());
{% endfor %}{% for item in model.parameters.values() %}    printf("param {{ item.name }} = %.17g\n", (double)data->owner->get_param_{{ item.name | readonly_value_identifier }}());
{% endfor %}    printf("action %d stage %d\n", (int)ctx->action_id, (int)ctx->action_stage_id);
}

{% endif %}
int main(void)
{
    Wrapper::InitOptions options;
    AppData data;
    memset(&options, 0, sizeof(options));
    memset(&data, 0, sizeof(data));
{% for item in model.parameters.values() %}    options.parameters.{{ item.name | readonly_value_identifier }} = 1;
    options.parameters_present.{{ item.name | readonly_value_identifier }} = 1;
{% endfor %}    Wrapper machine(options);
    data.owner = &machine;
    if (machine.last_error()[0] != '\0') {
        fprintf(stderr, "%s\n", machine.last_error());
        return 1;
    }
{% if model.inputs %}
    Wrapper::InputProvider provider;
    memset(&provider, 0, sizeof(provider));
{% for item in model.inputs.values() %}    data.inputs.{{ item.name | readonly_value_identifier }} = 1;
    provider.read_{{ item.name | readonly_value_identifier }} = app_read_{{ item.name | readonly_value_identifier }};
{% endfor %}    machine.set_input_provider(&provider, &data);
{% endif %}{% if abstract_ns.rows %}
    Wrapper::Hooks hooks = {{ m | upper }}_HOOKS_INIT;
{% for row in abstract_ns.rows %}    hooks.{{ row['hook_field'] }} = app_action;
{% endfor %}    machine.set_hooks(&hooks, &data);
{% endif %}
    /* Keep this instance and AppData alive for subsequent host-scheduled cycles. */
    if (!machine.cycle()) {
        fprintf(stderr, "%s\n", machine.last_error());
        return 2;
    }
{% for item in model.parameters.values() %}    printf("param {{ item.name }} = %.17g\n", (double)machine.get_param_{{ item.name | readonly_value_identifier }}());
{% endfor %}{% for item in model.persistent_variables.values() %}    printf("{{ item.role.value }} {{ item.name }} = %.17g\n",
           (double)machine.vars()->{{ item.name | to_c_identifier }});
{% endfor %}    printf("hook calls = %d\n", data.hook_calls);
    /* Send committed outputs to your actuator/driver after success. */
    return 0;
}
```

```bash
cc -std=c99 -O2 -c machine.c -o machine.o
c++ -std=c++98 -O2 machine.cpp app.cpp machine.o -lm -o app
./app
```

These commands target a POSIX hosted toolchain. See Build for Windows, CMake and no-heap integration. On each later tick, refresh `data.inputs` (or read the device inside the provider), then call the same cycle entry. Stop after `is_ended()` becomes true. Keep the instance, callback tables and application data alive for the whole run.

