def int a = 0;
def int b = 0;
state Workflow {
    event ADone;
    event Cancel;
    [*] -> Job;
    state Job {
        region A {
            [*] -> Working;
            state Working { during { a = a + 1; } }
            Working -> [*] : /ADone;
        }
        region B {
            [*] -> Working;
            state Working { during { b = b + 1; } }
        }
    }
    state Idle;
    Idle -> Job :: Back;
    !Job -> Idle : /Cancel;
}
