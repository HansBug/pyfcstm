static void _{{ M }}_event_set_reset(_{{ M }}EventSet *event_set)
{
    size_t i;

    for (i = 0u; i < sizeof(event_set->active_bitset) / sizeof(event_set->active_bitset[0]); ++i) {
        event_set->active_bitset[i] = 0ul;
        event_set->evaluated_bitset[i] = 0ul;
    }
}

/* Ask the check of one event, with the context of the configuration being examined. */
static int _{{ M }}_execute_event_check(
    _{{ M }}Priv *p,
    const _{{ M }}Ctx *context,
    int event_id)
{
    {{ M }}EventContext event_ctx;
    {{ M }} *machine = _{{ M }}_pub(p);

    if (!_{{ M }}_event_id_is_valid(event_id)) {
        _{{ M }}_set_error(machine, "Invalid event id: %d", event_id);
        return 0;
    }
    if (p->event_checks == NULL) {
        _{{ M }}_set_error(
            machine,
            "Event checks are not mounted for this c_poll runtime. Call {{ M }}_set_event_checks(...) before cycle().");
        return 0;
    }

    event_ctx.event_id = ({{ M }}EventId)event_id;
{% if not model.has_regions %}
    event_ctx.current_state_id = context->main.size > 0
        ? ({{ M }}StateId)context->main.frames[context->main.size - 1].state
        : {{ MM }}_INVALID_STATE_ID;
{% endif %}
    event_ctx.vars = &context->vars;

    switch (event_id) {
{% for event_path in event_list %}
    case {{ loop.index0 }}:
        return p->event_checks->{{ event_check_field_id_name(event_path) }}(
            machine,
            &event_ctx,
            p->event_check_user_data
        ) != 0;
{% endfor %}
    default:
        _{{ M }}_set_error(machine, "Invalid event id: %d", event_id);
        return 0;
    }
}

/* Whether the transition event `event_id` is active in this cycle: asked once, at the first need. */
static int _{{ M }}_event_active(_{{ M }}Priv *p, const _{{ M }}Ctx *context, int event_id)
{
    size_t word_index;
    unsigned long mask;
    int is_active;

    if (event_id < 0) {
        return 1;
    }
    word_index = (size_t)event_id / {{ MM }}_EVENTSET_WORD_BITS_INTERNAL;
    mask = 1ul << ((size_t)event_id % {{ MM }}_EVENTSET_WORD_BITS_INTERNAL);
    if ((p->events.evaluated_bitset[word_index] & mask) != 0ul) {
        return (p->events.active_bitset[word_index] & mask) != 0ul;
    }
    is_active = _{{ M }}_execute_event_check(p, context, event_id);
    p->events.evaluated_bitset[word_index] |= mask;
    if (is_active) {
        p->events.active_bitset[word_index] |= mask;
    }
    return is_active;
}

