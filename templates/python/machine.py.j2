    def _validate_position(self, position, base):
        path = position[0]
        if path[: len(base)] != base or len(path) <= len(base):
            raise ValueError(
                "Configuration path %s is outside namespace %s."
                % (_ERROR_REPR.repr(path), _ERROR_REPR.repr(base))
            )
        state = self._lookup(path)
        if _IS_REGION[state]:
            raise ValueError(
                "A configuration branch must end at a State, not a Region."
            )
        # A linear path cannot skip a parallel owner and select just one region.
        for end in range(len(base) + 1, len(path)):
            ancestor = self._lookup(path[:end])
            if _REGIONS[ancestor]:
                raise ValueError(
                    "Parallel owner %s requires a region block."
                    % _ERROR_REPR.repr(".".join(_PATH[ancestor]))
                )
        context = ".".join(path)
        entries = dict(position[1])
        if len(entries) != len(position[1]):
            raise ValueError(
                "Duplicate region in configuration for %s." % _ERROR_REPR.repr(context)
            )
        if set(entries) - set(_REGION_NAMES[state]):
            raise ValueError(
                "Unknown region in configuration for %s." % _ERROR_REPR.repr(context)
            )
        ordered = []
        for name in _REGION_NAMES[state]:
            child = entries.get(name, _PENDING)
            if isinstance(child, tuple):
                child = self._validate_position(child, path + (name,))
            ordered.append((name, child))
        return (path, tuple(ordered))

    def _parse_position(self, text):
        parser = _TextParser(text)
        try:
            position = parser.position()
            if parser.peek():
                parser.error("end of input")
            return self._validate_position(position, ())
        except RecursionError:
            # RecursionError: position() parses nested blocks and the validation
            # walks the resulting recursive position tree within Python's stack
            # limit.
            raise ValueError(
                "Configuration nesting is too deep near %s; "
                "reduce nested region blocks." % parser.location()
            ) from None

    @staticmethod
    def _position_of_state(state):
        node = (_PATH[state], tuple((name, _PENDING) for name in _REGION_NAMES[state]))
        scope = state
        while scope >= 0:
            if _IS_REGION[scope]:
                owner = _PARENT[scope]
                node = (
                    _PATH[owner],
                    tuple(
                        (name, node if name == _PATH[scope][-1] else _PENDING)
                        for name in _REGION_NAMES[owner]
                    ),
                )
            scope = _PARENT[scope]
        return node

    def _reject_all_done(self, position):
        if position[1] and all(child is None for _, child in position[1]):
            raise ValueError(
                "All regions are Done at '%s'; a finished owner cannot be hot-started."
                % ".".join(position[0])
            )
        for _, child in position[1]:
            if isinstance(child, tuple):
                self._reject_all_done(child)

    def _resolve_start_position(self, start):
        if isinstance(start, str) and "{" in start:
            position = self._parse_position(start)
        else:
            if isinstance(start, str):
                if not start:
                    raise ValueError("State path cannot be empty")
                path = tuple(start.split("."))
            elif isinstance(start, (tuple, list)):
                path = tuple(start)
            else:
                raise TypeError(
                    "initial_state must be str, tuple or list, got %s"
                    % type(start).__name__
                )
            found = self._lookup(path)
            if _IS_REGION[found]:
                raise ValueError("%r names a region, not a state" % ".".join(path))
            position = self._position_of_state(found)
        self._reject_all_done(position)
        return position

    def _build_position_stack(self, position, region=-1):
        chain = []
        scope = self._lookup(position[0])
        while scope != region:
            chain.insert(0, scope)
            scope = _PARENT[scope]
        frames = [_Frame(state, _ACTIVE) for state in chain]
        top = frames[-1]
        if position[1]:
            top.branches = []
            for name, child in position[1]:
                owned = _REGION_OF[top.state][name]
                if child is None:
                    stack = [_Frame(owned, _POST_CHILD_EXIT)]
                elif child is _PENDING:
                    stack = []
                else:
                    stack = [_Frame(owned, _ACTIVE)] + self._build_position_stack(
                        child, owned
                    )
                top.branches.append(_Branch(owned, stack))
            if all(branch.status == "pending" for branch in top.branches):
                top.mode = _INIT_WAIT
        elif not _IS_LEAF[top.state]:
            top.mode = _INIT_WAIT
        return frames

    # -- event names -------------------------------------------------------

    @staticmethod
    def _scope_resolve_event(scope, event_ref):
        """Resolve an event name from one state, the way ``State.resolve_event`` does."""
        if not event_ref:
            raise ModelValueError("Event reference cannot be empty")
        root = scope
        while _PARENT[root] >= 0:
            root = _PARENT[root]
        if event_ref.startswith("/"):
            relative_path = event_ref[1:]
            if not relative_path:
                raise ModelValueError("Absolute event reference cannot be just '/'")
            path_parts = relative_path.split(".")
            if not all(path_parts):
                raise ModelValueError(
                    "Invalid absolute event reference: %r" % (event_ref,)
                )
            event_name = path_parts[-1]
            target_path = _PATH[root] + tuple(path_parts[:-1])
        elif event_ref.startswith("."):
            dot_count = 0
            for char in event_ref:
                if char == ".":
                    dot_count += 1
                else:
                    break
            remaining_path = event_ref[dot_count:]
            if not remaining_path:
                raise ModelValueError(
                    "Parent-relative event reference cannot end with dots: %r"
                    % (event_ref,)
                )
            path_parts = remaining_path.split(".")
            if not all(path_parts):
                raise ModelValueError(
                    "Invalid parent-relative event reference: %r" % (event_ref,)
                )
            current = scope
            for _ in range(dot_count):
                if _PARENT[current] < 0:
                    raise ModelValueError(
                        "Parent-relative event reference %r goes beyond root state "
                        "(current state: %s, tried to go up %d levels)"
                        % (event_ref, ".".join(_PATH[scope]), dot_count)
                    )
                current = _PARENT[current]
            event_name = path_parts[-1]
            target_path = _PATH[current] + tuple(path_parts[:-1])
        else:
            path_parts = event_ref.split(".")
            if not all(path_parts):
                raise ModelValueError(
                    "Invalid relative event reference: %r" % (event_ref,)
                )
            event_name = path_parts[-1]
            target_path = _PATH[scope] + tuple(path_parts[:-1])
        current = root
        for index, name in enumerate(target_path[1:], 1):
            if _CHILD[current].get(name) is None:
                raise ModelLookupError(
                    "State %r not found in hierarchy while resolving event "
                    "reference %r" % (".".join(target_path[: index + 1]), event_ref)
                )
            current = _CHILD[current][name]
        if event_name not in _EVENTS[current]:
            raise ModelLookupError(
                "Event %r not found in state %r while resolving event reference %r"
                % (event_name, ".".join(target_path), event_ref)
            )
        return _EVENTS[current][event_name]

    @staticmethod
    def _machine_resolve_event(event_path):
        """Resolve a full event path, the way ``StateMachine.resolve_event`` does."""
        if not event_path:
            raise ModelValueError("Event path cannot be empty")
        path_parts = event_path.split(".")
        if not all(path_parts):
            raise ModelValueError(
                "Invalid event path: %r (contains empty parts)" % (event_path,)
            )
        if len(path_parts) < 2:
            raise ModelValueError(
                "Invalid event path: %r (must contain at least state name and "
                "event name)" % (event_path,)
            )
        event_name = path_parts[-1]
        state_path_parts = path_parts[:-1]
        if state_path_parts[0] != _PATH[0][-1]:
            raise ModelLookupError(
                "Event path root '%s' does not match state machine root '%s' "
                "while resolving event path %r"
                % (state_path_parts[0], _PATH[0][-1], event_path)
            )
        current = 0
        for index, name in enumerate(state_path_parts[1:], 1):
            if _CHILD[current].get(name) is None:
                raise ModelLookupError(
                    "State '%s' not found in state '%s' while resolving event "
                    "path %r" % (name, ".".join(state_path_parts[:index]), event_path)
                )
            current = _CHILD[current][name]
        if event_name not in _EVENTS[current]:
            raise ModelLookupError(
                "Event '%s' not found in state '%s' while resolving event path %r"
                % (event_name, ".".join(state_path_parts), event_path)
            )
        return _EVENTS[current][event_name]

    def _position_resolve_event(self, event_ref):
        """Resolve an event name from every active leaf of the current position."""
        # With no active leaf yet the name is looked up from the state the machine
        # rests on: the composite of a hot start in a model without regions, and
        # the root when regions that still wait leave nothing active.
        leaves = [self._lookup(path) for path in self.leaves] or [
            0 if _HAS_REGIONS else self._stack[-1].state
        ]
        if len(leaves) == 1:
            return self._scope_resolve_event(leaves[0], event_ref)
        if event_ref.startswith("/"):
            return self._scope_resolve_event(0, event_ref)
        found = {}
        errors = []
        for leaf in leaves:
            try:
                event = self._scope_resolve_event(leaf, event_ref)
            except (ModelValueError, ModelLookupError) as err:
                # ModelValueError / ModelLookupError: the name leads nowhere
                # from this leaf; another leaf may still find it.
                errors.append(err)
                continue
            found.setdefault(event, []).append(".".join(_PATH[leaf]))
        if not found:
            if all(isinstance(err, ModelValueError) for err in errors):
                # The name is malformed from every leaf, so there is nothing to
                # look up and the first complaint says why.
                raise errors[0]
            where = ", ".join(".".join(_PATH[leaf]) for leaf in leaves)
            raise ModelLookupError(
                "Position-dependent event name %s matches no event from any "
                'active leaf (%s); use the full event path or a root-based "/path".'
                % (_ERROR_REPR.repr(event_ref), where)
            )
        if len(found) > 1:
            candidates = "; ".join(
                "%s (from %s)" % (name, ", ".join(origins))
                for name, origins in found.items()
            )
            raise ModelValueError(
                "Position-dependent event name %s is ambiguous: %s; use the "
                'full event path or a root-based "/path".'
                % (_ERROR_REPR.repr(event_ref), candidates)
            )
        return next(iter(found))

    def _resolve_event_path(self, event):
        if event.startswith("/") or event.startswith("."):
            try:
                return self._position_resolve_event(event)
            except (ModelValueError, ModelLookupError) as err:
                # ModelValueError/ModelLookupError: the user-supplied
                # state-relative path is malformed or absent from the current
                # position.
                raise SimulationRuntimeEventError(str(err)) from err
        try:
            return self._machine_resolve_event(event)
        except (ModelValueError, ModelLookupError):
            # ModelValueError/ModelLookupError: the path was not a valid full
            # event path, so try the current position before surfacing a single
            # public diagnostic.
            try:
                return self._position_resolve_event(event)
            except (ModelValueError, ModelLookupError) as err:
                # ModelValueError/ModelLookupError: the same user-supplied
                # path also failed position-relative lookup.
                if len(self.leaves) > 1:
                    # With several active leaves the name was resolved from
                    # each of them, and the error says why it led nowhere or
                    # to several events; the fallback wording would bury it.
                    raise SimulationRuntimeEventError(str(err)) from err
                raise SimulationRuntimeEventError(
                    "Cannot resolve event path %r: "
                    "failed with both StateMachine.resolve_event and State.resolve_event. "
                    "Last error: %s" % (event, err)
                ) from err

    def _parse_event(self, event):
        if isinstance(event, str):
            return self._resolve_event_path(event)
        if hasattr(event, "path_name") and isinstance(event.path_name, str):
            return self._machine_event_object(event.path_name, event)
        raise SimulationRuntimeEventError(
            "Unsupported event input %r of type %r; "
            "expected an event path string or an object with a path_name."
            % (event, type(event))
        )

    def _machine_event_object(self, path_name, event):
        try:
            return self._machine_resolve_event(path_name)
        except (ModelValueError, ModelLookupError) as err:
            # ModelValueError/ModelLookupError: the caller supplied an event
            # object whose canonical path is malformed or absent from this
            # runtime's state machine.
            raise SimulationRuntimeEventError(
                "Event object %r does not resolve in this runtime: %s" % (event, err)
            ) from err

    def _normalize_events(self, events):
        if events is None:
            return ()
        if isinstance(events, str):
            events = [events]
        elif hasattr(events, "path_name"):
            raise SimulationRuntimeEventError(
                "Unsupported event input %r of type %r; "
                "expected an event path string, an event object, or an iterable "
                "of those values." % (events, type(events))
            )
        try:
            items = list(events)
        except TypeError as err:
            # TypeError: list(events) raises when the caller supplied a
            # non-iterable object that is not one of the supported single-event
            # shapes.
            raise SimulationRuntimeEventError(
                "Unsupported event input %r of type %r; "
                "expected an event path string, an event object, or an iterable "
                "of those values." % (events, type(events))
            ) from err
        return tuple(self._parse_event(item) for item in items)

    # -- actions and aspects -----------------------------------------------------

    def _hook(self, method, vars_, state_path, active_leaf, info):
        """Call one abstract hook with a read-only snapshot of this moment."""
        ctx = ReadOnlyExecutionContext(
            state_path=state_path,
            vars=dict(vars_),
            action_name=info[0],
            action_stage=info[1],
            active_leaf=active_leaf,
            call_stage=info[2],
            abstract_target=info[3],
            named_ref=info[4],
            parameters=self.parameters,
            inputs=self._context_inputs(),
            configuration=_position_text(_position_of_stack(self._root_stack)),
        )
        old_vars = self._vars
        self._vars = vars_
        try:
            method(ctx)
        finally:
            self._vars = old_vars

    def _wrapped_state_path(self, scope):
        stack, index = _find_frame_in(self._root_stack, scope)
        while True:
            frame = stack[index]
            if frame.branches is not None and len(frame.branches) == 1:
                stack, index = frame.branches[0].stack, 0
            elif (
                _IS_REGION[frame.state] or frame.branches is None
            ) and index + 1 < len(stack):
                index += 1
            else:
                break
        return _PATH[stack[index].state]

    def _flush_after_aspects(self, vars_, is_validation_mode, prefix=()):
        ledger = self._ledger
        owed = [
            scope
            for scope, entry in ledger.items()
            if entry[1] and _PATH[scope][: len(prefix)] == prefix
        ]
        for scope in sorted(owed, key=_FLUSH_RANK.__getitem__):
            ledger[scope][1] = False
            flush = self._ASPECT_AFTER[scope]
            if flush is not None:
                flush(self, vars_, is_validation_mode)

    @staticmethod
    def _copy_ledger(ledger):
        return {scope: list(entry) for scope, entry in ledger.items()}

    def _run_owner_plain_after(self, owner, vars_, is_validation_mode):
        run = self._PLAIN_AFTER[owner]
        if run is not None:
            run(self, vars_, is_validation_mode)

    # -- entering states and groups -------------------------------------------------

    def _attempt_init_transition(
        self, stack, vars_, d_events, is_validation_mode=False
    ):
        transition = self._PICK_INIT[stack[-1].state](
            self, stack, vars_, d_events, self._validate_initial_transition
        )
        if transition is None:
            return False
        self._TAKE[transition](self, stack, vars_, is_validation_mode)
        return True

    def _current_outer(self):
        return self._outer_chain[-1] if self._outer_chain else None

    def _init_group(self, stack, vars_, d_events, is_validation_mode=False, outer=None):
        self._init_depth += 1
        try:
            if self._init_depth > self._DFS_STRUCTURAL_DEPTH_LIMIT:
                limit = self._DFS_STRUCTURAL_DEPTH_LIMIT
                raise SimulationRuntimeDfsError(
                    "Group initialization nested deeper than the structural safety "
                    "limit (%s) within one cycle; the state machine either "
                    "enters more than %s groups inside one another or one "
                    "after another in the same cycle, or re-enters a group without "
                    "bound." % (limit, limit)
                )
            frame = stack[-1]
            pending = frame.plain_before_pending
            for index, branch in enumerate(frame.branches):
                region_frame = _Frame(branch.region, _INIT_WAIT, pending)
                branch.stack = [region_frame]
                run = _Run(is_validation_mode=is_validation_mode)
                self._outer_chain.append(_Outer(stack, index, outer))
                try:
                    outcome = self._advance_stack(branch.stack, vars_, d_events, run)
                finally:
                    self._outer_chain.pop()
                if outcome not in (_STABLE, _REGION_DONE):
                    return False
                self._flush_after_aspects(
                    vars_, is_validation_mode, _PATH[branch.region]
                )
                # The first non-pseudo child entered anywhere in the group consumes
                # the owner's plain ``during before`` boundary actions.
                pending = region_frame.plain_before_pending
            frame.plain_before_pending = False
            self._finish_group_advance(frame, vars_, is_validation_mode, entered=True)
            return True
        except RecursionError:
            # RecursionError: the interpreter's call stack ran out somewhere
            # below this group entry. Only note how deep the entries were
            # nested, so that the cycle can say so; nothing else is safe to do
            # this close to the limit.
            if self._overflow_depth is None:
                self._overflow_depth = self._init_depth
            raise
        finally:
            self._init_depth -= 1

    def _finish_group_advance(self, frame, vars_, is_validation_mode, entered=False):
        if all(branch.status == "done" for branch in frame.branches):
            self._run_owner_plain_after(frame.state, vars_, is_validation_mode)
            frame.mode = _POST_CHILD_EXIT
        else:
            frame.mode = _AFTER_ENTRY if entered else _ACTIVE

    def _advance_owner(self, stack, vars_, d_events, run):
        frame = stack[-1]
        if frame.mode == _INIT_WAIT:
            ok = self._init_group(
                stack,
                vars_,
                d_events,
                is_validation_mode=run.is_validation_mode,
                outer=self._current_outer(),
            )
            return _CONTINUE if ok else _FAILED
        for index, branch in enumerate(frame.branches):
            if branch.status == "done":
                continue
            if branch.status == "pending":
                # Only a hot start leaves an owner at work with a region that
                # has not been initialized: it gets its turn like the others.
                branch.stack = [_Frame(branch.region, _INIT_WAIT)]
            self._outer_chain.append(_Outer(stack, index, self._current_outer()))
            try:
                outcome = self._advance_stack(branch.stack, vars_, d_events, run)
            finally:
                self._outer_chain.pop()
            if outcome not in (_STABLE, _REGION_DONE):
                return _FAILED
            self._flush_after_aspects(
                vars_, run.is_validation_mode, _PATH[branch.region]
            )
        self._finish_group_advance(frame, vars_, run.is_validation_mode)
        return _CONTINUE if frame.mode == _POST_CHILD_EXIT else _STABLE

    # -- judging a candidate ------------------------------------------------------------

    def _continuation_viable(self, branch_stack, vars_, d_events, outer):
        owner_stack = _clone_stack(outer.stack)
        owner_frame = owner_stack[-1]
        owner_frame.branches[outer.index].stack = _clone_stack(branch_stack)
        if any(branch.status != "done" for branch in owner_frame.branches):
            return True
        sim_vars = dict(vars_)
        self._run_owner_plain_after(owner_frame.state, sim_vars, True)
        owner_frame.mode = _POST_CHILD_EXIT
        return self._owner_can_continue(owner_stack, sim_vars, d_events, outer.parent)

    def _owner_can_continue(self, owner_stack, vars_, d_events, outer):
        signature = _create_execution_signature(owner_stack, vars_)
        key = (signature, self._enclosing_shapes(outer))
        # A group only hands control back inside a check started by
        # _judge.
        self._memo_deps[-1].add(key)
        # Seeing this position again is the loop that the starting points of
        # the checks would find one round later; stopping here keeps the
        # nesting one level lower.
        if key in self._continuation_trail:
            raise _SimulationRuntimeLivelockError((signature, signature))
        self._continuation_trail.append(key)
        try:
            memo_key = self._memo_key(("continuation",), owner_stack, vars_, outer)
            viable = self._memo_get(memo_key)
            if viable is None:
                self._memo_deps.append(set())
                try:
                    viable = self._validation_search_reaches_stable(
                        owner_stack, vars_, d_events, outer=outer
                    )
                finally:
                    positions = self._memo_close()
                self._memo_put(memo_key, viable, positions)
            return viable
        finally:
            self._continuation_trail.pop()

    @staticmethod
    def _enclosing_shapes(outer):
        shapes = []
        while outer is not None:
            # The branch being examined is described by its own stack; what the
            # enclosing stack still holds in that slot may be out of date.
            shapes.append(_stack_shape(outer.stack, outer.index))
            outer = outer.parent
        return tuple(shapes)

    def _judge(self, stack, vars_, d_events, transition, validator):
        """Ask whether taking an enabled candidate can end in a stable position."""
        memo_key = self._memo_key(
            ("candidate", stack[-1].state, transition),
            stack,
            vars_,
            self._current_outer(),
        )
        # A check that is under way owns the point it started from. Coming
        # back to that point further in is a loop, whichever candidate is
        # asked about there: taking it for real would arrive here again and
        # choose the same way.
        origin = ("origin",) + memo_key[1:]
        if self._memo_deps:
            self._memo_deps[-1].add(origin)
        if origin in self._continuation_trail:
            # A region is not a state: a loop met while it picks its
            # initial transition is reported at its owner.
            where = stack
            if _IS_REGION[stack[-1].state]:
                where = self._current_outer().stack
            signature = _create_execution_signature(where, vars_)
            raise _SimulationRuntimeLivelockError((signature, signature))
        accepted = self._memo_get(memo_key)
        if accepted is None:
            self._continuation_trail.append(origin)
            self._memo_deps.append(set())
            try:
                accepted = validator(stack, vars_, transition, d_events)
            finally:
                positions = self._memo_close()
                self._continuation_trail.pop()
            self._memo_put(memo_key, accepted, positions)
        return accepted

    def _memo_key(self, tag, stack, vars_, outer):
        enclosing = []
        while outer is not None:
            enclosing.append(_stack_shape(outer.stack, outer.index))
            outer = outer.parent
        ledger = tuple(
            sorted((scope, entry[0], entry[1]) for scope, entry in self._ledger.items())
        )
        return (
            tag,
            _stack_shape(stack),
            tuple(sorted(vars_.items())),
            tuple(enclosing),
            ledger,
        )

    def _memo_get(self, key):
        entry = self._memo.get(key)
        if entry is None:
            return None
        result, positions, on_trail = entry
        if positions.intersection(self._continuation_trail) != on_trail:
            return None
        if self._memo_deps:
            self._memo_deps[-1].update(positions)
        return result

    def _memo_close(self):
        positions = self._memo_deps.pop()
        if self._memo_deps:
            self._memo_deps[-1].update(positions)
        return positions

    def _memo_put(self, key, result, positions):
        self._memo[key] = (
            result,
            frozenset(positions),
            frozenset(positions.intersection(self._continuation_trail)),
        )

    # -- transitions -----------------------------------------------------------------

    def _validate_initial_transition(self, stack, vars_, transition, d_events):
        sim_stack = _clone_stack(stack)
        sim_vars = dict(vars_)
        saved = self._ledger
        self._ledger = self._copy_ledger(saved)
        try:
            self._TAKE[transition](self, sim_stack, sim_vars, True)
            return self._validation_search_reaches_stable(
                sim_stack,
                sim_vars,
                d_events,
                trail=(_create_execution_signature(stack, vars_),),
            )
        finally:
            self._ledger = saved

    def _finalize_exit_to_parent(self, stack, vars_, is_validation_mode=False):
        if not stack:
            return True
        parent = stack[-1].state
        if _IS_REGION[parent]:
            # The child left through ``[*]`` directly under a region: the region
            # is done. It has no ``during after`` action to run.
            stack[-1].mode = _POST_CHILD_EXIT
            return False
        self._run_owner_plain_after(parent, vars_, is_validation_mode)
        if _PARENT[parent] < 0:
            leave = self._EXIT[parent]
            if leave is not None:
                leave(self, vars_, is_validation_mode)
            stack.clear()
            return True
        stack[-1].mode = _POST_CHILD_EXIT
        return False

    def _select_transition(
        self,
        stack,
        vars_,
        d_events,
        validate_stoppable=True,
        force_validate=False,
    ):
        current = stack[-1].state
        validator = (
            self._validate_transition
            if validate_stoppable and (_IS_STOPPABLE[current] or force_validate)
            else None
        )
        return self._PICK_OUT[current](self, stack, vars_, d_events, validator)

    def _validate_transition(self, stack, vars_, transition, d_events):
        saved = self._ledger
        self._ledger = self._copy_ledger(saved)
        try:
            sim_stack = _clone_stack(stack)
            sim_vars = dict(vars_)
            ended = self._TAKE[transition](self, sim_stack, sim_vars, True)
            if ended:
                return True
            return self._validation_search_reaches_stable(
                sim_stack,
                sim_vars,
                d_events,
                trail=(_create_execution_signature(stack, vars_),),
            )
        finally:
            self._ledger = saved

    def _check_structural_limit(self, stack):
        if len(stack) > self._DFS_STRUCTURAL_DEPTH_LIMIT:
            raise SimulationRuntimeDfsError(
                "Speculative DFS exceeded the structural stack-depth safety limit "
                "(%s) without reaching a stoppable state or pruning; "
                "the state machine likely contains an invalid unbounded nesting chain."
                % (self._DFS_STRUCTURAL_DEPTH_LIMIT,)
            )

    def _check_step_limit(self, steps_taken):
        if steps_taken >= self._DFS_STEP_LIMIT:
            raise SimulationRuntimeDfsError(
                "Speculative DFS exceeded the step safety limit "
                "(%s) without reaching a stoppable state or pruning; "
                "the state machine likely contains an invalid unbounded pseudo-state "
                "or transition chain." % (self._DFS_STEP_LIMIT,)
            )

    # -- searching for a stable position ---------------------------------------------

    def _validation_search_reaches_stable(
        self, stack, vars_, d_events, trail=(), outer=_UNSET
    ):
        saved = self._ledger
        try:
            return self._search_stable_continuation(
                stack, vars_, d_events, trail=trail, outer=outer
            )
        finally:
            self._ledger = saved

    def _search_stable_continuation(
        self, stack, vars_, d_events, trail=(), outer=_UNSET
    ):
        if outer is _UNSET:
            outer = self._current_outer()
        original_ledger = self._ledger
        worklist = [
            (
                _clone_stack(stack),
                dict(vars_),
                False,
                trail,
                self._copy_ledger(original_ledger),
            )
        ]
        loop_error = None
        seen_signatures = set()
        steps_taken = 0
        while worklist:
            current_stack, current_vars, current_ended, trail, current_ledger = (
                worklist.pop()
            )
            if current_ended:
                stack.clear()
                vars_.clear()
                vars_.update(current_vars)
                return True
            self._check_structural_limit(current_stack)
            signature = _create_execution_signature(current_stack, current_vars)
            if signature in trail:
                loop_error = _SimulationRuntimeLivelockError(
                    trail[trail.index(signature) :] + (signature,)
                )
                continue
            if signature in seen_signatures:
                continue
            seen_signatures.add(signature)
            next_trail = trail + (signature,)
            self._check_step_limit(steps_taken)
            steps_taken += 1
            frame = current_stack[-1]
            state = frame.state
            if _IS_REGION[state]:
                # Only a finished region can be on top of a searched stack: its
                # initial transition already ran before the search started.
                self._ledger = self._copy_ledger(current_ledger)
                try:
                    viable = self._continuation_viable(
                        current_stack, current_vars, d_events, outer
                    )
                except _SimulationRuntimeLivelockError as error:
                    # _SimulationRuntimeLivelockError: the owner's continuation
                    # leads back to the same position. That kills this path
                    # only; other worklist items may still succeed.
                    loop_error = error
                    continue
                if viable:
                    stack[:] = current_stack
                    vars_.clear()
                    vars_.update(current_vars)
                    return True
                continue
            if frame.branches is not None and frame.mode == _INIT_WAIT:
                next_stack = _clone_stack(current_stack)
                next_vars = dict(current_vars)
                self._ledger = self._copy_ledger(current_ledger)
                try:
                    initialized = self._init_group(
                        next_stack,
                        next_vars,
                        d_events,
                        is_validation_mode=True,
                        outer=outer,
                    )
                except _SimulationRuntimeLivelockError as error:
                    # _SimulationRuntimeLivelockError: a region's own initial
                    # candidates loop without a stable exit. That only kills
                    # this path; other items of the worklist may still succeed.
                    loop_error = error
                    continue
                if initialized:
                    worklist.append(
                        (next_stack, next_vars, False, next_trail, self._ledger)
                    )
                continue
            if frame.branches is not None and frame.mode in (_ACTIVE, _AFTER_ENTRY):
                # Every working region rests on a stable leaf.
                stack[:] = current_stack
                vars_.clear()
                vars_.update(current_vars)
                return True
            if _IS_LEAF[state] and frame.mode == _AFTER_ENTRY:
                next_stack = _clone_stack(current_stack)
                next_vars = dict(current_vars)
                self._ledger = self._copy_ledger(current_ledger)
                next_stack[-1].mode = _ACTIVE
                if _IS_STOPPABLE[state]:
                    stack[:] = next_stack
                    vars_.clear()
                    vars_.update(next_vars)
                    return True
                worklist.append(
                    (next_stack, next_vars, False, next_trail, self._ledger)
                )
                continue
            if frame.mode == _INIT_WAIT and not _IS_LEAF[state]:
                for transition in self._ENABLED_INIT[state](
                    self, current_vars, d_events
                ):
                    next_stack = _clone_stack(current_stack)
                    next_vars = dict(current_vars)
                    self._ledger = self._copy_ledger(current_ledger)
                    self._TAKE[transition](self, next_stack, next_vars, True)
                    worklist.append(
                        (next_stack, next_vars, False, next_trail, self._ledger)
                    )
                continue
            # A pseudo leaf (a stoppable leaf entry returned above) routes on,
            # and every other frame in the search is a parent whose child exited.
            for transition in self._ENABLED_OUT[state](self, current_vars, d_events):
                next_stack = _clone_stack(current_stack)
                next_vars = dict(current_vars)
                self._ledger = self._copy_ledger(current_ledger)
                next_ended = self._TAKE[transition](self, next_stack, next_vars, True)
                worklist.append(
                    (next_stack, next_vars, next_ended, next_trail, self._ledger)
                )
        if loop_error is not None:
            raise loop_error
        return False

    # -- one cycle ---------------------------------------------------------------------------

    def _initialize_context(self, stack, vars_, d_events, is_validation_mode=False):
        stack.clear()
        if not is_validation_mode:
            self._root_stack = stack
        self._enter_0(stack, vars_, is_validation_mode)
        return len(stack) == 0

    def _run_cycle_on_context(
        self,
        stack,
        vars_,
        d_events,
        validate_post_child_exit=True,
        is_validation_mode=False,
    ):
        run = _Run(
            is_validation_mode=is_validation_mode,
            validate_post_child_exit=validate_post_child_exit,
        )
        self._outer_chain = []
        if not is_validation_mode:
            self._root_stack = stack
        outcome = self._advance_stack(stack, vars_, d_events, run)
        if outcome == _STABLE:
            # Work is always followed by a stable boundary, so a cycle that
            # ends the machine owes no aspect.
            self._flush_after_aspects(vars_, is_validation_mode)
            return True, False
        if outcome == _ENDED:
            return True, True
        return False, False

    def _advance_stack(self, stack, vars_, d_events, run):
        is_validation_mode = run.is_validation_mode
        validate_post_child_exit = run.validate_post_child_exit
        while True:
            if not _LOOP_FREE:
                signature = _create_execution_signature(stack, vars_)
                if signature in run.seen_signatures:
                    return _FAILED
                run.seen_signatures.add(signature)
            self._check_structural_limit(stack)
            self._check_step_limit(run.steps_taken)
            frame = stack[-1]
            state = frame.state
            if _IS_REGION[state]:
                if frame.mode == _POST_CHILD_EXIT:
                    return _REGION_DONE
                progressed = self._attempt_init_transition(
                    stack, vars_, d_events, is_validation_mode=is_validation_mode
                )
                run.steps_taken += 1
                if not progressed:
                    return _FAILED
                continue
            if _NO_OUTGOING_PSEUDO[state]:
                return _FAILED
            if frame.branches is not None and frame.mode == _AFTER_ENTRY:
                frame.mode = _ACTIVE
                return _STABLE
            if frame.branches is not None and frame.mode != _POST_CHILD_EXIT:
                outcome = self._advance_owner(stack, vars_, d_events, run)
                run.steps_taken += 1
                if outcome == _CONTINUE:
                    continue
                return outcome
            if _IS_LEAF[state]:
                if frame.mode == _AFTER_ENTRY:
                    frame.mode = _ACTIVE
                    if _IS_STOPPABLE[state]:
                        return _STABLE
                    run.steps_taken += 1
                    continue
                transition = self._select_transition(
                    stack,
                    vars_,
                    d_events,
                    force_validate=not _IS_STOPPABLE[state],
                )
                if transition is not None:
                    ended = self._TAKE[transition](
                        self, stack, vars_, is_validation_mode
                    )
                    run.steps_taken += 1
                    if ended:
                        return _ENDED
                    continue
                self._DURING[state](self, vars_, is_validation_mode)
                frame.mode = _AFTER_ENTRY
                run.steps_taken += 1
                continue
            if frame.mode == _POST_CHILD_EXIT:
                transition = self._select_transition(
                    stack,
                    vars_,
                    d_events,
                    validate_stoppable=validate_post_child_exit,
                    force_validate=validate_post_child_exit,
                )
                ended = self._TAKE[transition](self, stack, vars_, is_validation_mode)
                run.steps_taken += 1
                if ended:
                    return _ENDED
                continue
            # A composite that is waiting for its initial transition.
            progressed = self._attempt_init_transition(
                stack, vars_, d_events, is_validation_mode=is_validation_mode
            )
            run.steps_taken += 1
            if not progressed:
                return _FAILED{% endraw %}

