output float shared = 1;
state Root {
    import "../modules/input_probe_float.fcstm" as A {
        var sample -> shared;
        var entered -> A_entered;
        var exited -> A_exited;
    }
    import "../modules/input_probe_float.fcstm" as B {
        var sample -> shared;
        var entered -> B_entered;
        var exited -> B_exited;
    }
    [*] -> A;
    A -> B effect { shared = 2; };
}
