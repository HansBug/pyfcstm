output int order = 0;

state Workflow {
    event ADone;
    event Cancel;
    [*] -> Job;
    state Job {
        exit { order = order * 10 + 3; }
        region A {
            [*] -> Working;
            state Working { exit { order = order * 10 + 1; } }
            Working -> [*] : /ADone;
        }
        region B {
            [*] -> Working;
            state Working { exit { order = order * 10 + 2; } }
        }
    }
    state Idle;
    !Job -> Idle : /Cancel;
}
