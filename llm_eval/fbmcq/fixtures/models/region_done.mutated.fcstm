def int loaded = 0;
def int checked = 0;

state Line {
    [*] -> Job;

    state Job {
        region Loader {
            [*] -> Loading;
            state Loading { during { loaded = loaded + 1; } }
            Loading -> [*] : if [loaded >= 2];
        }
        region Checker {
            [*] -> Waiting;
            state Waiting;
            state Measuring { during { checked = checked + 1; } }
            Waiting -> Measuring : if [loaded >= 99];
            Measuring -> [*] : if [checked >= 2];
        }
    }

    state Packed;

    Job -> Packed;
}
