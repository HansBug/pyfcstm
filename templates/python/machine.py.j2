    def _normalize_persistent_value(self, name, value, source):
        if name not in self._VALUE_TYPES:
            raise ValueError(
                "Variable %r not defined in state machine. Available variables: %s"
                % (name, list(self._VAR_TYPES.keys()))
            )
        declared_type = self._VALUE_TYPES[name]
        if type(value) is bool:
            raise SimulationRuntimeExpressionError("%s must not be bool" % (source,))
        if type(value) not in (int, float):
            raise SimulationRuntimeExpressionError(
                "%s must be int or float, got %s" % (source, type(value).__name__)
            )
        if type(value) is float and not math.isfinite(value):
            raise SimulationRuntimeExpressionError(
                "%s for variable %r declared %s must be finite, got %r"
                % (source, name, declared_type, value)
            )
        if declared_type == "int":
            if type(value) is float:
                if value != int(value):
                    raise SimulationRuntimeExpressionError(
                        "Variable %r is int type, cannot assign float %r; "
                        "non-integer float from %s" % (name, value, source)
                    )
                return int(value)
            return value
        if declared_type == "float":
            try:
                normalized_float = float(value)
            except OverflowError as err:
                # OverflowError: ``float(value)`` cannot represent a very
                # large Python integer as a finite runtime float.
                raise SimulationRuntimeExpressionError(
                    "%s for variable %r declared float must be finite; "
                    "integer is outside Python float range" % (source, name)
                ) from err
            if not math.isfinite(normalized_float):
                raise SimulationRuntimeExpressionError(
                    "%s for variable %r declared float must be finite, got %r"
                    % (source, name, normalized_float)
                )
            return normalized_float
        raise SimulationRuntimeExpressionError(
            "Variable %r has unsupported persistent type %r" % (name, declared_type)
        )

    @staticmethod
    def _sign(value):
        """
        Return the FCSTM sign value for one numeric expression.

        :param value: Numeric expression value.
        :type value: Number
        :return: ``-1`` for negative values and NaN, ``0`` for zero, and ``1``
            for positive values.
        :rtype: int

        Example::

            >>> {{ machine_class_name(model) }}._sign(-3)
            -1
        """
        return 0 if value == 0 else (1 if value > 0 else -1)

    @staticmethod
    def _power(base, exponent):
        """
        Return ``base ** exponent`` with FCSTM real-valued semantics.

        Python returns a complex number for a negative base raised to a
        fractional power; FCSTM has no complex values, so that is an error.

        :param base: Power base.
        :type base: Number
        :param exponent: Power exponent.
        :type exponent: Number
        :return: The real power.
        :rtype: Number
        :raises ValueError: If the result would be complex.

        Example::

            >>> {{ machine_class_name(model) }}._power(-2, 2)
            4
        """
        result = base**exponent
        if isinstance(result, complex):
            raise ValueError("negative number cannot be raised to a fractional power")
        return result

    @staticmethod
    def _math(function, value):
        """
        Apply a math function, reporting a domain error with one message.

        Python reports an argument outside a function's domain with a
        ``ValueError`` whose wording changed in Python 3.14; FCSTM reports it
        as ``math domain error`` on every version.

        :param function: Math function to apply.
        :type function: Callable
        :param value: Function argument.
        :type value: Number
        :return: The function value.
        :rtype: Number
        :raises ValueError: If the argument is outside the function's domain.

        Example::

            >>> {{ machine_class_name(model) }}._math(math.sqrt, 4)
            2.0
        """
        try:
            return function(value)
        except ValueError:
            # ValueError: the argument is outside the function's domain,
            # such as sqrt of a negative number or log of zero.
            raise ValueError("math domain error") from None

    @staticmethod
    def _cbrt(value):
        """
        Return the real cube root, exact on perfect cubes.

        The platform ``cbrt`` is not correctly rounded everywhere, so this
        refines ``abs(x) ** (1/3)`` with one Newton step, as the simulator does.

        :param value: Number to take the cube root of.
        :type value: Number
        :return: The real cube root.
        :rtype: float

        Example::

            >>> {{ machine_class_name(model) }}._cbrt(-8)
            -2.0
        """
        value = float(value)
        if value == 0.0 or not math.isfinite(value):
            return value
        root = math.copysign(abs(value) ** (1.0 / 3.0), value)
        root -= (root * root * root - value) / (3.0 * root * root)
        nearest = float(math.floor(root + 0.5))
        if nearest * nearest * nearest == value:
            return nearest
        return root

    def _execute_operation_block(self, operations, vars_, source):
        local_scope = dict(vars_)
        operations(local_scope)
        try:
            normalized_updates = {
                name: self._normalize_persistent_value(
                    name,
                    local_scope[name],
                    source,
                )
                for name in self.VARIABLE_NAMES
            }
        except ValueError as err:
            # ValueError: the block left a value its variable's declared type
            # rejects; a failed writeback is a runtime error of the cycle.
            raise SimulationRuntimeExpressionError(str(err)) from None
        for name, value in normalized_updates.items():
            vars_[name] = value

