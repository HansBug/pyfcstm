{% set resolved = namespace(item=item, seen=[]) -%}
{% for _ in range(action_ref_hop_limit) -%}
{% if resolved.item.ref is not none and resolved.item not in resolved.seen -%}
{% set resolved.seen = resolved.seen + [resolved.item] -%}
{% set resolved.item = resolved.item.ref -%}
{% endif -%}
{% endfor -%}
{% if resolved.item.is_abstract and resolved.item.func_name not in abstract_ns.rows | map(attribute='func_name') | list -%}
{% set abstract_ns.rows = abstract_ns.rows + [{
    'func_name': resolved.item.func_name,
    'hook_name': action_hook_name(resolved.item),
    'owner_path': action_owner_path(resolved.item),
    'stage': resolved.item.stage,
    'aspect': resolved.item.aspect,
}] -%}
{% endif -%}
{% endfor -%}
{% endfor -%}
{% endfor %}

{% if abstract_ns.rows %}
例如：

```python
class CustomMachine({{ machine_class_name(model) }}):
    def {{ abstract_ns.rows[0]['hook_name'] }}(self, ctx):
        print(ctx.get_full_state_path(), ctx.action_name, ctx.action_stage)
        print(ctx.vars)
        return None
```

