{%- set hook_ns = namespace(seen=[]) -%}
{%- set methods = namespace(items=[]) -%}
{%- for state in state_items -%}
{%- for method_kind, group in [
    ('enter', state.list_on_enters(with_ids=True)),
    ('during', state.list_on_durings(aspect=None, with_ids=True)),
    ('exit', state.list_on_exits(with_ids=True)),
    ('during_before', state.list_on_durings(aspect='before', with_ids=True)),
    ('during_after', state.list_on_durings(aspect='after', with_ids=True)),
    ('aspect_before', state.list_on_during_aspects(aspect='before', with_ids=True)),
    ('aspect_after', state.list_on_during_aspects(aspect='after', with_ids=True)),
] -%}
{%- for id_, item in group -%}
{%- set resolved = namespace(item=item, seen=[]) -%}
{%- for _ in range(action_ref_hop_limit) -%}
{%- if resolved.item.ref is not none and resolved.item not in resolved.seen -%}
{%- set resolved.seen = resolved.seen + [resolved.item] -%}
{%- set resolved.item = resolved.item.ref -%}
{%- endif -%}
{%- endfor -%}
{%- if resolved.item.is_abstract and resolved.item.func_name not in hook_ns.seen -%}
{%- set hook_ns.seen = hook_ns.seen + [resolved.item.func_name] -%}
{%- set methods.items = methods.items + [render_abstract_hook_method(resolved.item)] -%}
{%- endif -%}
{%- if not resolved.item.is_abstract -%}
{%- set methods.items = methods.items + [render_action_method(state, method_kind, id_, resolved.item)] -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- for transition in state.init_transitions -%}
{%- if transition.guard is not none -%}
{%- set methods.items = methods.items + [render_init_guard_method(state, loop.index, transition)] -%}
{%- endif -%}
{%- if transition.effects -%}
{%- set methods.items = methods.items + [render_init_effect_method(state, loop.index, transition)] -%}
{%- endif -%}
{%- endfor -%}
{%- for transition in state.transitions_from -%}
